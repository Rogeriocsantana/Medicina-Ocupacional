{
  "name": "aso-pcmso-clinica-pierro",
  "version": "1.2.0",
  "description": "Sistema de gestão ocupacional e emissão de ASO com persistência MySQL",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "db:check": "node server/check-db.js",
    "db:migrate": "node server/migrate-db.js",
    "db:clear-test-data": "node server/clear-test-data.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/ASO-PCMSO-ClinicaPierro.exe"
  },
  "pkg": {
    "scripts": [
      "server/**/*.js"
    ],
    "assets": [
      "views/**/*",
      "public/**/*",
      "database/**/*",
      "node_modules/pdfkit/js/data/**/*",
      "node_modules/es-get-iterator/**/*"
    ]
  },
  "dependencies": {
    "dayjs": "^1.11.10",
    "ejs": "^3.1.10",
    "es-get-iterator": "^1.1.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "mysql2": "^3.15.3",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
