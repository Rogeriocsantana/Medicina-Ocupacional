<% const pageTitle = 'Cargos'; %>
<%- include('partials/head', {pageTitle}) %>
<%- include('partials/nav', {pageTitle, active: 'cargos'}) %>

<div class="approved-page-header">
  <div>
    <h3 class="approved-page-title">Defina os cargos e perfis ocupacionais</h3>
    <p class="approved-page-subtitle">Gerencie funções, perfis ocupacionais e vínculos com setores.</p>
  </div>
  <div class="approved-header-actions">
    <a class="approved-button" href="<%= baseUrl('api/importacoes/cadastros/cargos/modelo') %>" download><span data-ui-icon="download"></span>Baixar modelo</a>
    <button class="approved-button" type="button" onclick="document.getElementById('arquivo-cargos').click()"><span data-ui-icon="upload"></span>Importar planilha</button>
    <button class="approved-button primary" type="button" onclick="abrirModal()"><span data-ui-icon="plus"></span>Novo cargo</button>
    <input id="arquivo-cargos" class="approved-import-input" type="file" accept=".xlsx">
  </div>
</div>
<div class="mb-3">
  <div class="approved-search"><span data-ui-icon="search"></span><input id="busca" type="text" placeholder="Buscar cargo, setor ou empresa" class="approved-input"></div>
</div>

<div class="approved-data-card">
  <table class="w-full text-left border-collapse">
    <thead class="bg-background-main border-b border-border-subtle">
      <tr>
        <th class="px-6 py-4">Cargo</th><th class="px-6 py-4">Setor</th><th class="px-6 py-4">Perfil ocupacional</th><th class="px-6 py-4">Funcionários</th><th class="px-6 py-4 text-right">Ações</th>
      </tr>
    </thead>
    <tbody id="tbody-cargos" class="divide-y divide-border-subtle font-table-data text-table-data">
      <tr><td colspan="5" class="px-6 py-4 text-on-surface-variant">Carregando...</td></tr>
    </tbody>
  </table>
  <div id="paginacao-cargos" class="px-4"></div>
</div>

<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center modal-backdrop">
  <div class="bg-surface rounded-xl w-full max-w-md p-6">
    <h3 id="modal-titulo" class="font-headline-md text-headline-md mb-4">Adicionar Cargo</h3>
    <form id="form-cargo" class="space-y-4">
      <input type="hidden" id="cargo-id">
      <div>
        <label class="block text-body-md font-semibold mb-1">Nome do Cargo</label>
        <input id="cargo-nome" required class="w-full px-4 py-2.5 border border-border-subtle rounded-lg focus:ring-2 focus:ring-primary" placeholder="Ex: Líder de Cozinha">
      </div>
      <div class="flex justify-end gap-3 pt-2">
        <button type="button" onclick="fecharModal()" class="px-5 py-2.5 rounded-lg font-semibold text-on-surface-variant hover:bg-surface-container-low">Cancelar</button>
        <button type="submit" class="px-5 py-2.5 rounded-lg font-bold bg-primary text-white hover:opacity-90">Salvar</button>
      </div>
    </form>
  </div>
</div>

<!-- Colaboradores do cargo -->
<div id="modal-colaboradores-cargo" class="fixed inset-0 z-50 hidden items-center justify-center modal-backdrop">
  <div class="bg-surface rounded-xl w-full max-w-4xl p-6 max-h-[90vh] flex flex-col">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div>
        <h3 class="font-headline-md text-headline-md">Colaboradores do cargo</h3>
        <p id="colaboradores-cargo-nome" class="text-on-surface-variant mt-1"></p>
      </div>
      <button type="button" onclick="fecharColaboradoresCargo()" class="modal-close-button p-2 text-on-surface-variant rounded-lg" title="Fechar">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="mb-4 relative max-w-lg">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
      <input id="busca-colaboradores-cargo" type="text" placeholder="Buscar por setor ou nome do colaborador..." class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-border-subtle rounded-lg focus:ring-2 focus:ring-primary text-body-md">
    </div>
    <div class="border border-border-subtle rounded-xl overflow-y-auto overflow-x-hidden flex-1">
      <table class="w-full table-fixed text-left border-collapse text-sm">
        <thead class="bg-background-main border-b border-border-subtle sticky top-0">
          <tr>
            <th class="px-4 py-3 font-label-caps text-label-caps uppercase">Colaborador</th>
            <th class="px-4 py-3 font-label-caps text-label-caps uppercase">Setor atual</th>
            <th class="px-4 py-3 font-label-caps text-label-caps uppercase">Situação</th>
            <th class="w-16 px-3 py-3 font-label-caps text-label-caps uppercase text-center">Ação</th>
          </tr>
        </thead>
        <tbody id="tbody-colaboradores-cargo" class="divide-y divide-border-subtle font-table-data text-table-data"></tbody>
      </table>
    </div>
    <div class="flex items-center justify-between gap-4 pt-4">
      <p id="total-colaboradores-cargo" class="text-on-surface-variant text-sm"></p>
      <button type="button" onclick="fecharColaboradoresCargo()" class="modal-close-button px-5 py-2.5 rounded-lg font-semibold text-on-surface-variant">Fechar</button>
    </div>
  </div>
</div>

<script>
let paginaCargos = 1;
const ITENS_POR_PAGINA = 7;
let buscaCargosAtual = '';
let colaboradoresCargo = [];
let cargoColaboradoresAtual = null;
async function carregarCargos(busca = buscaCargosAtual) {
  buscaCargosAtual = busca;
  const tbody = document.getElementById('tbody-cargos');
  try {
    const [todosCargos, funcionarios] = await Promise.all([api('cargos'), api('funcionarios')]);
    const cargos = todosCargos.map(cargo => { const vinculados=funcionarios.filter(f=>String(f.CargoID)===String(cargo.ID)); return {...cargo, TotalFuncionarios:vinculados.length, SetorNome:vinculados[0]?.SetorNome||'—', EmpresaNome:vinculados[0]?.EmpresaNome||'—'} }).filter(cargo => `${cargo.Nome||''} ${cargo.SetorNome||''} ${cargo.EmpresaNome||''}`.toLowerCase().includes(busca.toLowerCase().trim()));
    if (!cargos.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-4 text-on-surface-variant">Nenhum cargo cadastrado.</td></tr>';
      return;
    }
    const pagina = cargos.slice((paginaCargos - 1) * ITENS_POR_PAGINA, paginaCargos * ITENS_POR_PAGINA);
    tbody.innerHTML = pagina.map(c => `
      <tr class="hover:bg-[#EBF2FA] transition-colors group">
        <td class="px-6 py-4 font-semibold">${escapeHtml(c.Nome)}</td><td class="px-6 py-4">${escapeHtml(c.SetorNome)}</td><td class="px-6 py-4">—</td><td class="px-6 py-4">${c.TotalFuncionarios}</td>
        <td class="px-6 py-4 text-center">
          <div class="approved-table-actions">
            <button onclick='abrirColaboradoresCargo(${JSON.stringify(c).replace(/'/g, "&#39;")})' class="approved-action" title="Ver colaboradores"><span class="material-symbols-outlined">group</span></button>
            <button onclick='editar(${JSON.stringify(c).replace(/'/g, "&#39;")})' class="approved-action" title="Editar cargo"><span class="material-symbols-outlined">edit</span></button>
            <button onclick="excluir(${c.ID})" class="approved-action danger" title="Excluir cargo"><span class="material-symbols-outlined">delete</span></button>
          </div>
        </td>
      </tr>`).join('');
    document.getElementById('paginacao-cargos').innerHTML = htmlPaginacao(paginaCargos, cargos.length, ITENS_POR_PAGINA, 'irPaginaCargos');
  } catch (err) {
    tbody.innerHTML = `<tr><td colspan="3" class="px-6 py-4 text-error">${err.message}</td></tr>`;
  }
}
function irPaginaCargos(pagina) { if (pagina >= 1) { paginaCargos = pagina; carregarCargos(); } }
let debounceBuscaCargos;
document.getElementById('busca').addEventListener('input', (e) => { clearTimeout(debounceBuscaCargos); paginaCargos = 1; debounceBuscaCargos = setTimeout(() => carregarCargos(e.target.value), 250); });

function abrirModal() {
  document.getElementById('modal-titulo').textContent = 'Adicionar Cargo';
  document.getElementById('cargo-id').value = '';
  document.getElementById('cargo-nome').value = '';
  document.getElementById('modal').classList.remove('hidden');
  document.getElementById('modal').classList.add('flex');
}
function fecharModal() {
  document.getElementById('modal').classList.add('hidden');
  document.getElementById('modal').classList.remove('flex');
}
function editar(cargo) {
  document.getElementById('modal-titulo').textContent = 'Editar Cargo';
  document.getElementById('cargo-id').value = cargo.ID;
  document.getElementById('cargo-nome').value = cargo.Nome;
  document.getElementById('modal').classList.remove('hidden');
  document.getElementById('modal').classList.add('flex');
}

async function abrirColaboradoresCargo(cargo, buscaInicial = '') {
  cargoColaboradoresAtual = cargo;
  const modal = document.getElementById('modal-colaboradores-cargo');
  const tbody = document.getElementById('tbody-colaboradores-cargo');
  document.getElementById('colaboradores-cargo-nome').textContent = cargo.Nome || '';
  document.getElementById('busca-colaboradores-cargo').value = buscaInicial;
  tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-4 text-on-surface-variant">Carregando...</td></tr>';
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  try {
    const funcionarios = await api('funcionarios');
    colaboradoresCargo = funcionarios.filter(f => String(f.CargoID) === String(cargo.ID));
    colaboradoresCargo.sort((a, b) => String(a.SetorNome || '').localeCompare(String(b.SetorNome || ''), 'pt-BR') || String(a.Nome || '').localeCompare(String(b.Nome || ''), 'pt-BR'));
    renderColaboradoresCargo();
    document.getElementById('busca-colaboradores-cargo').focus();
  } catch (err) {
    tbody.innerHTML = `<tr><td colspan="4" class="px-4 py-4 text-error">${escapeHtml(err.message)}</td></tr>`;
  }
}

function renderColaboradoresCargo() {
  const busca = document.getElementById('busca-colaboradores-cargo').value.toLowerCase().trim();
  const filtrados = colaboradoresCargo.filter(f =>
    String(f.Nome || '').toLowerCase().includes(busca) ||
    String(f.SetorNome || '').toLowerCase().includes(busca)
  );
  const tbody = document.getElementById('tbody-colaboradores-cargo');
  tbody.innerHTML = filtrados.length ? filtrados.map(f => `
    <tr class="hover:bg-[#EBF2FA] transition-colors">
      <td class="px-4 py-3 font-semibold">${escapeHtml(f.Nome || '')}</td>
      <td class="px-4 py-3">${escapeHtml(f.SetorNome || '')}</td>
      <td class="px-4 py-3">${situacaoEtiqueta(f.Situacao)}</td>
      <td class="px-3 py-3 text-center">
        <button onclick="editarColaboradorCargo(${f.ID})" aria-label="Corrigir cargo ou setor" class="inline-flex w-9 h-9 items-center justify-center text-primary hover:bg-primary-fixed rounded-lg" title="Corrigir cargo ou setor">
          <span class="material-symbols-outlined text-[20px]">edit</span>
        </button>
      </td>
    </tr>`).join('') : '<tr><td colspan="4" class="px-4 py-4 text-on-surface-variant">Nenhum colaborador encontrado neste cargo.</td></tr>';
  document.getElementById('total-colaboradores-cargo').textContent = busca
    ? `${filtrados.length} de ${colaboradoresCargo.length} colaborador(es)`
    : `${colaboradoresCargo.length} colaborador(es)`;
}

function fecharColaboradoresCargo() {
  const modal = document.getElementById('modal-colaboradores-cargo');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

function editarColaboradorCargo(id) {
  if (!cargoColaboradoresAtual) return;
  const retorno = new URLSearchParams({
    colaboradores: String(cargoColaboradoresAtual.ID),
    buscaLista: document.getElementById('busca').value,
    pagina: String(paginaCargos),
    buscaColaboradores: document.getElementById('busca-colaboradores-cargo').value
  });
  const destinoRetorno = `${appUrl('cargos')}?${retorno.toString()}`;
  const destino = new URLSearchParams({ editar: String(id), retorno: destinoRetorno });
  window.location.href = `${appUrl('funcionarios')}?${destino.toString()}`;
}

document.getElementById('busca-colaboradores-cargo').addEventListener('input', renderColaboradoresCargo);
document.getElementById('arquivo-cargos').addEventListener('change', async e => {
  const arquivo=e.target.files[0]; if(!arquivo)return;
  try { const resposta=await fetch(apiUrl('importacoes/cadastros/cargos'),{method:'POST',headers:{'Content-Type':'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'},body:await arquivo.arrayBuffer()}); const dados=await resposta.json(); if(!resposta.ok)throw new Error(dados.erro||'Falha ao importar.'); toast(`${dados.importados} cargo(s) importado(s).${dados.ignorados?` ${dados.ignorados} já existente(s).`:''}`); await carregarCargos(); } catch(error){toast(error.message,'erro')} finally {e.target.value=''}
});

document.getElementById('form-cargo').addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('cargo-id').value;
  const nome = document.getElementById('cargo-nome').value.trim();
  if (!nome) return;
  try {
    if (id) {
      await api(`cargos/${id}`, { method: 'PUT', body: JSON.stringify({ Nome: nome }) });
      toast('Cargo atualizado com sucesso.');
    } else {
      await api('cargos', { method: 'POST', body: JSON.stringify({ Nome: nome }) });
      toast('Cargo adicionado com sucesso.');
    }
    fecharModal();
    carregarCargos();
  } catch (err) {
    toast(err.message, 'erro');
  }
});

async function excluir(id) {
  if (!await confirmarExclusao('Excluir este cargo? Esta ação não pode ser desfeita.')) return;
  try {
    await api(`cargos/${id}`, { method: 'DELETE' });
    toast('Cargo excluído.');
    carregarCargos();
  } catch (err) {
    toast(err.message, 'erro');
  }
}

(async function iniciarCargos() {
  const params = new URLSearchParams(window.location.search);
  const buscaLista = params.get('buscaLista') || '';
  paginaCargos = Math.max(1, Number(params.get('pagina')) || 1);
  document.getElementById('busca').value = buscaLista;
  await carregarCargos(buscaLista);
  const cargoId = params.get('colaboradores');
  if (cargoId) {
    try {
      const cargo = await api(`cargos/${encodeURIComponent(cargoId)}`);
      await abrirColaboradoresCargo(cargo, params.get('buscaColaboradores') || '');
    } catch (error) { toast(error.message, 'erro'); }
  }
})();
</script>

<%- include('partials/foot') %>
