<% const pageTitle = 'Registros'; %>
<%- include('partials/head', {pageTitle}) %>
<%- include('partials/nav', {pageTitle, active: 'registros-ocupacionais'}) %>

<div class="approved-page-header">
  <div>
    <h3 id="titulo-registros" class="approved-page-title">Acompanhe os registros ocupacionais</h3>
    <p id="subtitulo-registros" class="approved-page-subtitle">Controle central dos registros vinculados aos funcionários.</p>
  </div>
  <div class="approved-header-actions">
    <a id="btn-modelo" class="approved-button" href="#"><span data-ui-icon="download"></span>Baixar modelo</a>
    <button id="btn-importar-registro" class="approved-button" onclick="document.getElementById('arquivo-importacao').click()"><span data-ui-icon="upload"></span>Importar planilha</button>
    <button id="btn-novo-registro" class="approved-button primary" onclick="abrirNovoRegistro()"><span data-ui-icon="filePlus"></span>Novo registro</button>
    <input id="arquivo-importacao" type="file" accept=".xlsx" class="hidden">
  </div>
</div>
<p id="orientacao-atestados" class="hidden modern-subtitle mb-4">No modelo, preencha CPF, Código Funcionário ou Cod + Nome. Ao usar código, informe o CNPJ da empresa. Confira o vínculo na prévia antes de importar.</p>
<div class="modern-tabs line-tabs mb-4 overflow-x-auto" id="tabs-registros"><a href="<%= baseUrl('historico') %>" class="modern-tab whitespace-nowrap">ASOs e documentos</a><button class="modern-tab active whitespace-nowrap" data-tipo="exames">Exames realizados</button><button class="modern-tab whitespace-nowrap" data-tipo="acidentes">Acidentes / CAT</button><button class="modern-tab whitespace-nowrap" data-tipo="encaminhamentos">Encaminhamentos</button><button class="modern-tab whitespace-nowrap" data-tipo="atestados">Atestados</button><button class="modern-tab whitespace-nowrap" data-tipo="condicoes">Condições</button><button class="modern-tab whitespace-nowrap" data-tipo="presencas">Presença médica</button></div>
<div id="filtros-registros" class="mb-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[minmax(20rem,1fr)_minmax(11rem,13rem)_minmax(8rem,10rem)] gap-3 items-center">
  <div class="approved-search w-full md:col-span-2 xl:col-span-1"><span data-ui-icon="search"></span><input id="filtro-busca" type="text" placeholder="Buscar nome, CPF, empresa ou setor..." class="approved-input w-full"></div>
  <div id="filtro-condicao-wrap" class="hidden"><select id="filtro-condicao" aria-label="Filtrar condição" class="approved-input w-full"><option value="">Todas as condições</option><option>FÉRIAS</option><option>GESTANTE</option><option>PUERPÉRIO</option><option>LICENÇA MÉDICA</option><option>AFASTADO</option><option>OUTRA</option></select></div>
  <select id="filtro-mes" aria-label="Filtrar mês" class="approved-input w-full"><option value="">Todos os meses</option><% ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'].forEach((mes,indice)=>{ %><option value="<%= indice+1 %>"><%= mes %></option><% }) %></select>
  <select id="filtro-ano" aria-label="Filtrar ano" class="approved-input w-full"><option value="">Todos os anos</option><% for(let ano=new Date().getFullYear()+1;ano>=2020;ano--){ %><option value="<%= ano %>" <%= ano===new Date().getFullYear()?'selected':'' %>><%= ano %></option><% } %></select>
</div>
<style>@media(min-width:1280px){#filtros-registros.filtros-condicoes{grid-template-columns:minmax(18rem,1fr) minmax(11rem,15rem) minmax(11rem,15rem) minmax(8rem,11rem)}}</style>
<div id="registros-padrao" class="approved-data-card"><div class="overflow-x-auto"><table class="w-full min-w-[900px] table-fixed text-left border-collapse leading-5"><colgroup><col class="w-[30%]"><col class="w-[26%]"><col class="w-[20%]"><col class="w-[14%]"><col class="w-[10%]"></colgroup><thead><tr id="cabecalho-registros"></tr></thead><tbody id="corpo-registros" class="divide-y divide-border-subtle font-table-data text-table-data"><tr><td colspan="5" class="px-6 py-4 text-on-surface-variant">Carregando...</td></tr></tbody></table></div><div id="paginacao-registros"></div></div>
<%- include('partials/registros-condicoes-presencas') %>

<div id="modal-registro" class="hidden fixed inset-0 z-50 modal-backdrop p-4 items-center justify-center"><div class="modern-surface w-full max-w-3xl p-5 max-h-[92vh] overflow-y-auto"><div class="flex justify-between items-center mb-4"><h3 id="titulo-modal" class="text-xl font-semibold">Novo registro</h3><button onclick="fecharFormulario()" aria-label="Fechar"><span data-ui-icon="close"></span></button></div><form id="form-registro"><input id="registro-id" type="hidden"><div id="campos-registro" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div><div class="flex justify-end gap-2 mt-5"><button type="button" class="modern-control px-4" onclick="fecharFormulario()">Cancelar</button><button class="modern-primary px-5 py-2.5">Salvar</button></div></form></div></div>
<div id="modal-importacao" class="hidden fixed inset-0 z-50 modal-backdrop p-4 items-center justify-center"><div class="modern-surface w-full max-w-5xl p-5 max-h-[92vh] overflow-y-auto"><div class="flex justify-between items-center mb-3"><div><h3 class="text-xl font-semibold">Prévia da importação</h3><p id="resumo-importacao" class="modern-subtitle"></p></div><button onclick="fecharImportacao()"><span data-ui-icon="close"></span></button></div><div class="overflow-x-auto"><table class="modern-table w-full"><thead><tr><th class="px-3 py-2">Linha</th><th id="importacao-coluna-cpf">CPF</th><th id="importacao-coluna-detalhe">Funcionário</th><th>Data</th><th>Validação</th></tr></thead><tbody id="corpo-importacao"></tbody></table></div><div class="flex justify-end gap-2 mt-4"><button class="modern-control px-4" onclick="fecharImportacao()">Cancelar</button><button id="confirmar-importacao" class="modern-primary px-5 py-2.5">Importar válidos</button></div></div></div>

<script>
let tipoAtual='exames', registros=[], pagina=1, itensImportacao=[], condicoesPrimeiraAbertura=true;
const ITENS_POR_PAGINA_REGISTROS=5;
const campos={
  exames:[['funcionario','Funcionário','funcionario'],['data','Data do exame','date'],['tipo_exame','Tipo do exame','select:ADMISSIONAL,PERIÓDICO,DEMISSIONAL,RETORNO AO TRABALHO,MUDANÇA DE FUNÇÃO,CONSULTA'],['alteracao_pa','Alteração de PA','select:,SIM,NÃO'],['alteracao_glicemia','Alteração de glicemia','select:,SIM,NÃO'],['observacao','Observação','textarea']],
  acidentes:[['funcionario','Funcionário','funcionario'],['data','Data do acidente','date'],['descricao','Descrição','textarea'],['agente_causador','Agente causador','text'],['perfurocortante','Perfurocortante','select:NÃO,SIM'],['cat_emitida','CAT emitida','select:PENDENTE,SIM,NÃO'],['afastamento','Afastamento','select:,SIM,NÃO'],['dias_atestado','Dias de atestado','number'],['cid','CID','text'],['acompanhamento_30','Acompanhamento 30 dias','date'],['acompanhamento_90','Acompanhamento 90 dias','date'],['observacao','Observação','textarea']],
  encaminhamentos:[['funcionario','Funcionário','funcionario'],['data','Data','date'],['especialidade','Especialidade / destino','text'],['motivo','Motivo','textarea'],['situacao','Situação','select:PENDENTE,AGENDADO,CONCLUÍDO,CANCELADO'],['data_conclusao','Data de conclusão','date'],['observacao','Observação','textarea']],
  atestados:[['funcionario','Funcionário','funcionario'],['data_emissao','Data de emissão','date'],['data_inicio','Data de início','date'],['data_retorno','Data de retorno','date'],['tipo','Tipo','select:DIAS,HORAS'],['quantidade','Quantidade','number'],['cid','CID','text'],['profissional','Médico / dentista','text'],['registro_profissional','CRM / CRO','text'],['cnes','CNES','text'],['afastamento_inss','Afastamento INSS','select:NÃO,SIM'],['observacao','Observação','textarea']]
};
function inputCampo([nome,label,tipo]){if(tipo==='funcionario')return `<label class="md:col-span-2 text-sm font-medium">${label}<div class="relative mt-1"><span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span><input name="funcionario_busca" type="text" autocomplete="off" placeholder="Buscar por nome ou CPF..." class="modern-control pl-10 pr-4 w-full" required><input name="funcionario_id" type="hidden"><div id="lista-funcionarios-registro" class="hidden absolute z-30 left-0 right-0 mt-1 bg-surface border border-border-subtle rounded-lg shadow-lg max-h-56 overflow-y-auto"></div></div><small class="block mt-1 text-on-surface-variant font-normal">Selecione um funcionário cadastrado para vincular o registro.</small></label>`;if(tipo==='textarea')return `<label class="md:col-span-2 text-sm font-medium">${label}<textarea name="${nome}" class="modern-control px-3 py-2 h-20 mt-1 w-full"></textarea></label>`;if(tipo.startsWith('select:'))return `<label class="text-sm font-medium">${label}<select name="${nome}" class="modern-control px-3 mt-1 w-full">${tipo.slice(7).split(',').map(v=>`<option value="${v.normalize('NFD').replace(/[\u0300-\u036f]/g,'')}">${v||'Selecione'}</option>`).join('')}</select></label>`;return `<label class="text-sm font-medium">${label}<input name="${nome}" type="${tipo}" class="modern-control px-3 mt-1 w-full"></label>`}
let debounceBuscaRegistro=null, funcionariosBuscaRegistro=new Map();
function limparSelecaoFuncionarioRegistro(){const form=document.getElementById('form-registro');if(!form)return;if(form.elements.funcionario_id)form.elements.funcionario_id.value='';}
async function buscarFuncionariosRegistro(termo){const lista=document.getElementById('lista-funcionarios-registro');if(!lista)return;const q=String(termo||'').trim();if(q.length<2){lista.classList.add('hidden');lista.innerHTML='';return}try{const rows=await api(`funcionarios?busca=${encodeURIComponent(q)}`);funcionariosBuscaRegistro=new Map(rows.map(f=>[String(f.ID),f]));if(!rows.length){lista.innerHTML='<p class="px-4 py-3 text-on-surface-variant text-body-md">Nenhum funcionário encontrado.</p>';lista.classList.remove('hidden');return}lista.innerHTML=rows.slice(0,8).map(f=>`<button type="button" data-funcionario-id="${escapeHtml(f.ID)}" class="w-full text-left px-4 py-3 hover:bg-primary-fixed border-b border-border-subtle last:border-0"><span class="font-semibold block">${escapeHtml(f.Nome)}</span><span class="text-on-surface-variant text-body-md">CPF ${escapeHtml(formatCpf(f.CPF||''))} · ${escapeHtml(f.CargoNome||'')}</span></button>`).join('');lista.classList.remove('hidden');lista.querySelectorAll('[data-funcionario-id]').forEach(btn=>btn.addEventListener('click',()=>selecionarFuncionarioRegistro(btn.dataset.funcionarioId)))}catch(err){toast(err.message,'erro')}}
function selecionarFuncionarioRegistro(id){const func=funcionariosBuscaRegistro.get(String(id));const form=document.getElementById('form-registro');const busca=form?.elements.funcionario_busca;if(!func||!form||!busca)return;form.elements.funcionario_id.value=func.ID;busca.value=func.Nome||'';document.getElementById('lista-funcionarios-registro')?.classList.add('hidden');busca.focus()}
function configurarBuscaFuncionarioRegistro(registro=null){const form=document.getElementById('form-registro'),busca=form?.elements.funcionario_busca;if(!busca)return;if(registro){if(form.elements.funcionario_id)form.elements.funcionario_id.value=registro.funcionario_id||'';busca.value=registro.funcionario||''}busca.addEventListener('input',()=>{limparSelecaoFuncionarioRegistro();clearTimeout(debounceBuscaRegistro);debounceBuscaRegistro=setTimeout(()=>buscarFuncionariosRegistro(busca.value),250)});busca.addEventListener('focus',()=>{if(busca.value.trim().length>=2)buscarFuncionariosRegistro(busca.value)})}
document.addEventListener('click',event=>{const lista=document.getElementById('lista-funcionarios-registro');if(lista&&!event.target.closest('#lista-funcionarios-registro')&&!event.target.closest('[name="funcionario_busca"]'))lista.classList.add('hidden')});
function abrirFormulario(registro=null){document.getElementById('campos-registro').innerHTML=campos[tipoAtual].map(inputCampo).join('');document.getElementById('registro-id').value=registro?.id||'';document.getElementById('titulo-modal').textContent=registro?'Editar registro':'Novo registro';if(registro){const form=document.getElementById('form-registro');campos[tipoAtual].forEach(([nome])=>{if(form.elements[nome])form.elements[nome].value=registro[nome]??(nome==='cpf'?registro.cpf:'')})}configurarBuscaFuncionarioRegistro(registro);const modal=document.getElementById('modal-registro');modal.classList.remove('hidden');modal.classList.add('flex');renderUiIcons(modal)}
function fecharFormulario(){const m=document.getElementById('modal-registro');m.classList.add('hidden');m.classList.remove('flex')}
function fecharImportacao(){const m=document.getElementById('modal-importacao');m.classList.add('hidden');m.classList.remove('flex')}
function formatarData(v){if(!v)return '—';const [y,m,d]=String(v).slice(0,10).split('-');return `${d}/${m}/${y}`}
function detalhe(r){if(tipoAtual==='exames')return `${r.tipo_exame}${r.alteracao_pa===1?' · PA alterada':''}`;if(tipoAtual==='acidentes')return `${r.descricao}${r.cat_emitida?` · CAT ${r.cat_emitida}`:''}`;if(tipoAtual==='atestados')return `${r.tipo==='HORAS'?`${r.quantidade} hora(s)`:`${r.quantidade} dia(s)`}${r.cid?` · CID ${r.cid}`:''}${Number(r.afastamento_inss)?' · INSS':''}`;return `${r.especialidade} · ${r.situacao}`}
function btnAcaoRegistro({onclick,title,icon,cor='primary'}){const cls=cor==='error'?'text-error hover:bg-error-container':'text-primary hover:bg-primary-fixed';return `<button type="button" onclick="${onclick}" title="${title}" aria-label="${title}" class="inline-flex items-center justify-center w-8 h-8 rounded ${cls}"><span class="material-symbols-outlined" style="font-size:20px">${icon}</span></button>`}
function renderLista(){const busca=document.getElementById('filtro-busca').value.toLowerCase();const lista=registros.filter(r=>[r.funcionario,r.cpf,r.empresa,r.setor,r.cargo,detalhe(r)].some(v=>String(v||'').toLowerCase().includes(busca)));const totalPaginas=Math.max(1,Math.ceil(lista.length/ITENS_POR_PAGINA_REGISTROS));if(pagina>totalPaginas)pagina=totalPaginas;const inicio=(pagina-1)*ITENS_POR_PAGINA_REGISTROS,paginados=lista.slice(inicio,inicio+ITENS_POR_PAGINA_REGISTROS);document.getElementById('cabecalho-registros').innerHTML='<th class="px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase">Nome</th><th class="px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase">Empresa / setor</th><th class="px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase">Detalhes</th><th class="px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase whitespace-nowrap">Data</th><th class="px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase text-right"><span class="hidden md:inline">Ações</span></th>';document.getElementById('corpo-registros').innerHTML=paginados.length?paginados.map(r=>`<tr class="hover:bg-[#EBF2FA] transition-colors"><td class="px-4 py-3"><span class="font-semibold block">${escapeHtml(r.funcionario||'')}</span><span class="modern-subtitle">CPF ${escapeHtml(formatCpf(r.cpf||''))}</span></td><td class="px-4 py-3"><span class="block">${escapeHtml(r.empresa||'')}</span><span class="modern-subtitle">${escapeHtml(r.setor||'')}</span></td><td class="px-4 py-3">${escapeHtml(detalhe(r))}</td><td class="px-4 py-3 text-on-surface-variant whitespace-nowrap">${formatarData(r.data_exame||r.data_acidente||r.data_encaminhamento||r.data_inicio)}</td><td class="px-4 py-3 whitespace-nowrap"><div class="flex flex-nowrap items-center justify-end gap-0.5">${btnAcaoRegistro({onclick:`editarPorId(${r.id})`,title:'Editar',icon:'edit'})}${btnAcaoRegistro({onclick:`excluirRegistro(${r.id})`,title:'Excluir',icon:'delete',cor:'error'})}</div></td></tr>`).join(''):'<tr><td colspan="5" class="px-4 py-3 text-on-surface-variant">Nenhum registro encontrado.</td></tr>';document.getElementById('paginacao-registros').innerHTML=htmlPaginacao(pagina,lista.length,ITENS_POR_PAGINA_REGISTROS,'irPaginaRegistros')}
function irPaginaRegistros(novaPagina){const total=Math.max(1,Math.ceil(registros.length/ITENS_POR_PAGINA_REGISTROS));if(novaPagina>=1&&novaPagina<=total){pagina=novaPagina;renderLista()}}
function editar(r){const copy={...r,cpf:r.cpf,data:r.data_exame||r.data_acidente||r.data_encaminhamento||r.data_inicio};abrirFormulario(copy)}
function editarPorId(id){const registro=registros.find(r=>Number(r.id)===Number(id));if(registro)editar(registro)}
async function carregar(){const q=new URLSearchParams(),ano=Number(document.getElementById('filtro-ano').value),mes=Number(document.getElementById('filtro-mes').value);if(mes&&!ano){toast('Selecione um ano para filtrar por mês.','erro');return}if(ano){const inicio=mes?`${ano}-${String(mes).padStart(2,'0')}-01`:`${ano}-01-01`,fim=mes?`${ano}-${String(mes).padStart(2,'0')}-${new Date(ano,mes,0).getDate()}`:`${ano}-12-31`;q.set('inicio',inicio);q.set('fim',fim)}registros=await api(`registros/${tipoAtual}?${q}`);pagina=1;document.getElementById('titulo-registros').textContent='Acompanhe os registros ocupacionais';document.getElementById('subtitulo-registros').textContent='Controle central dos registros vinculados aos funcionários.';renderLista();document.getElementById('btn-modelo').href=baseUrl(`api/registros/${tipoAtual}/modelo`)}
document.querySelectorAll('#tabs-registros button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#tabs-registros button').forEach(x=>x.classList.remove('active'));b.classList.add('active');tipoAtual=b.dataset.tipo;history.replaceState(null,'',`?aba=${tipoAtual}`);alternarTipoRegistro()});
function abrirNovoRegistro(){if(tipoAtual==='condicoes')abrirCondicao();else if(tipoAtual==='presencas')abrirPresenca();else abrirFormulario()}
function alternarTipoRegistro(){document.getElementById('orientacao-atestados').classList.toggle('hidden',tipoAtual!=='atestados');const especial=tipoAtual==='condicoes'||tipoAtual==='presencas',condicoes=tipoAtual==='condicoes';document.getElementById('registros-padrao').classList.toggle('hidden',especial);document.getElementById('painel-condicoes').classList.toggle('hidden',!condicoes);document.getElementById('painel-presencas').classList.toggle('hidden',tipoAtual!=='presencas');document.getElementById('filtro-condicao-wrap').classList.toggle('hidden',!condicoes);document.getElementById('filtros-registros').classList.toggle('filtros-condicoes',condicoes);if(condicoes&&condicoesPrimeiraAbertura){condicoesPrimeiraAbertura=false;if(!document.getElementById('filtro-mes').value){const ano=document.getElementById('filtro-ano');ano.value='';ano.dispatchEvent(new Event('change',{bubbles:true}));return}}document.getElementById('btn-modelo').href=baseUrl(`api/registros/${tipoAtual}/modelo`);document.getElementById('filtro-busca').placeholder=tipoAtual==='presencas'?'Buscar data ou observação...':condicoes?'Buscar funcionário, CPF ou condição...':'Buscar nome, CPF, empresa ou setor...';document.getElementById('importacao-coluna-cpf').textContent=tipoAtual==='presencas'?'Registro':tipoAtual==='atestados'?'Identificação / CPF':'CPF';document.getElementById('importacao-coluna-detalhe').textContent=tipoAtual==='presencas'?'Observação':condicoes?'Funcionário / condição':'Funcionário';if(condicoes)carregarCondicoes();else if(tipoAtual==='presencas')carregarPresencas();else carregar()}
document.getElementById('filtro-busca').oninput=()=>{pagina=1;if(tipoAtual==='condicoes')renderCondicoes();else if(tipoAtual==='presencas')renderPresencas();else renderLista()};document.getElementById('filtro-condicao').onchange=()=>{if(tipoAtual==='condicoes')carregarCondicoes()};document.getElementById('filtro-mes').onchange=()=>{const ano=document.getElementById('filtro-ano');if(document.getElementById('filtro-mes').value&&!ano.value){ano.value=String(new Date().getFullYear());ano.dispatchEvent(new Event('change',{bubbles:true}));return}alternarTipoRegistro()};document.getElementById('filtro-ano').onchange=alternarTipoRegistro;
document.getElementById('form-registro').onsubmit=async e=>{e.preventDefault();try{const id=document.getElementById('registro-id').value,data=Object.fromEntries(new FormData(e.target));if(!data.funcionario_id){toast('Selecione um funcionário pelo nome ou CPF.','erro');return}delete data.funcionario_busca;delete data.cpf;await api(`registros/${tipoAtual}${id?'/'+id:''}`,{method:id?'PUT':'POST',body:JSON.stringify(data)});fecharFormulario();toast('Registro salvo.','sucesso');carregar()}catch(err){toast(err.message,'erro')}};
async function excluirRegistro(id){if(!await confirmarExclusao('Excluir este registro?'))return;try{await api(`registros/${tipoAtual}/${id}`,{method:'DELETE'});toast('Registro excluído.','sucesso');carregar()}catch(err){toast(err.message,'erro')}}
document.getElementById('arquivo-importacao').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const response=await fetch(baseUrl(`api/registros/${tipoAtual}/analisar`),{method:'POST',headers:{'Content-Type':'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'},body:await file.arrayBuffer()});const data=await response.json();if(!response.ok)throw new Error(data.erro);itensImportacao=data.itens;const validos=itensImportacao.filter(x=>!x.erros.length).length;document.getElementById('confirmar-importacao').disabled=validos===0;document.getElementById('resumo-importacao').textContent=`${validos} válido(s) e ${itensImportacao.length-validos} com erro.`;document.getElementById('corpo-importacao').innerHTML=itensImportacao.map(x=>`<tr><td class="px-3 py-2">${x.linha}</td><td>${tipoAtual==='atestados'?`${escapeHtml(x.cod_nome||x.codigo_funcionario||x.cpf||'—')}<span class="modern-subtitle block">${escapeHtml(x.cnpj?'CNPJ '+x.cnpj:'')}${x.cpf?' · CPF '+escapeHtml(x.cpf):''}</span>`:escapeHtml(x.cpf||'—')}</td><td>${escapeHtml(x.funcionario||x.condicao||x.observacao||'—')}</td><td>${formatarData(x.data||x.data_inicio||x.data_presenca)}</td><td class="${x.erros.length?'text-error':'text-green-700'}">${escapeHtml(x.erros.join('; ')||'Pronto para importar')}</td></tr>`).join('');const m=document.getElementById('modal-importacao');m.classList.remove('hidden');m.classList.add('flex');renderUiIcons(m)}catch(err){toast(err.message,'erro')}finally{e.target.value=''}};
document.getElementById('confirmar-importacao').onclick=async()=>{try{const r=await api(`registros/${tipoAtual}/importar`,{method:'POST',body:JSON.stringify({itens:itensImportacao})});fecharImportacao();toast(`${r.importados} registro(s) importado(s).`,'sucesso');alternarTipoRegistro()}catch(err){toast(err.message,'erro')}};const abaInicial=new URLSearchParams(location.search).get('aba');if(['exames','acidentes','encaminhamentos','atestados','condicoes','presencas'].includes(abaInicial)){tipoAtual=abaInicial;document.querySelectorAll('#tabs-registros button').forEach(x=>x.classList.toggle('active',x.dataset.tipo===tipoAtual))}alternarTipoRegistro();
</script>
