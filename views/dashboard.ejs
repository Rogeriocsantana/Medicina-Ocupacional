<% const pageTitle = 'Painel'; %>
<%- include('partials/head', {pageTitle}) %>
<%- include('partials/nav', {pageTitle, active: 'dashboard'}) %>

<section class="approved-dashboard">
  <div class="approved-heading">
    <div><h3>Monitore a saúde dos funcionários</h3><p>Acompanhe exames, prazos e indicadores para priorizar os cuidados ocupacionais.</p></div>
  </div>
  <div class="approved-kpis">
    <article class="approved-kpi"><div><span class="approved-icon blue"><span data-ui-icon="users"></span></span><span>Funcionários ativos</span></div><strong id="stat-ativos">–</strong><small id="stat-total">Carregando...</small></article>
    <article class="approved-kpi"><div><span class="approved-icon green">✓</span><span>Exames no prazo</span></div><strong id="stat-prazo-percentual">–</strong><small id="stat-prazo">– funcionários</small><em id="taxa-prazo" class="approved-rate green">–</em></article>
    <article class="approved-kpi"><div><span class="approved-icon purple"><span data-ui-icon="calendar"></span></span><span>A vencer em 30 dias</span></div><strong id="stat-vencer30">–</strong><small>priorizar agendamento</small><em class="approved-rate purple">30 dias</em></article>
    <article class="approved-kpi"><div><span class="approved-icon amber"><span data-ui-icon="alert"></span></span><span>Exames atrasados</span></div><strong id="stat-atrasados">–</strong><small>precisam de atenção</small></article>
  </div>
  <div class="approved-quick-links">
    <a href="<%= baseUrl('gerar-pdf') %>"><span><span data-ui-icon="filePlus"></span></span><b>Gerar ASO</b><small>Selecionar funcionário</small></a>
    <a href="<%= baseUrl('importar-funcionarios') %>"><span><span data-ui-icon="upload"></span></span><b>Importar funcionários</b><small>Adicionar ou atualizar em lote</small></a>
    <a href="<%= baseUrl('indicadores') %>?aba=vencimentos"><span><span data-ui-icon="calendar"></span></span><b>Ver vencimentos</b><small>Planejar próximos exames</small></a>
    <a href="<%= baseUrl('indicadores') %>"><span><span data-ui-icon="dashboard"></span></span><b>Indicadores</b><small>Analisar dados ocupacionais</small></a>
  </div>
  <div class="approved-dashboard-grid">
    <article class="approved-panel"><h4>Exames realizados por mês</h4><p>Volume consolidado nos últimos meses</p><div id="grafico-meses" class="approved-bars"><span class="text-on-surface-variant">Carregando...</span></div></article>
    <article class="approved-panel"><h4>Próximos vencimentos</h4><p>Distribuição por faixa</p><div id="faixas-vencimento"><div class="approved-list-row"><span>Carregando...</span><b>–</b></div></div></article>
  </div>
</section>

<script>
async function carregarDashboard() {
  try {
    const stats = await api('dashboard/stats');
    const ativos = Number(stats.funcionariosAtivos || 0), total = Number(stats.totalFuncionarios || 0);
    const noPrazo = Number(stats.examesNoPrazo || 0), elegiveis = Math.max(1, noPrazo + Number(stats.examesAtrasados || 0));
    const percentual = Math.round(noPrazo / elegiveis * 100);
    document.getElementById('stat-ativos').textContent = ativos;
    document.getElementById('stat-total').textContent = `de ${total} cadastrados`;
    document.getElementById('stat-prazo-percentual').textContent = `${percentual}%`;
    document.getElementById('taxa-prazo').textContent = `${percentual}%`;
    document.getElementById('stat-prazo').textContent = `${noPrazo} funcionários`;
    document.getElementById('stat-vencer30').textContent = Number(stats.vencer30 || 0);
    document.getElementById('stat-atrasados').textContent = Number(stats.examesAtrasados || 0);
    const meses = stats.asosPorMes || [], maior = Math.max(1, ...meses.map(item => Number(item.total || 0)));
    document.getElementById('grafico-meses').innerHTML = meses.map(item => { const altura=Math.max(6,Number(item.total||0)/maior*100); return `<div><b class="approved-chart-value" style="--bar-height:${altura}%">${Number(item.total||0)}</b><i style="height:${altura}%" title="${item.total} ASO(s)"></i><span>${escapeHtml(item.mes)}</span></div>` }).join('');
    document.getElementById('faixas-vencimento').innerHTML = (stats.faixasVencimento || []).map(item => `<div class="approved-list-row"><span>${escapeHtml(item.faixa)}</span><b>${Number(item.total || 0)}</b></div>`).join('');
  } catch (error) { toast(error.message, 'erro'); }
}
carregarDashboard();
</script>

<%- include('partials/foot') %>
