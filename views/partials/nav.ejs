<body class="bg-background-main text-on-surface">
<div id="mo-navigation-progress" aria-hidden="true"><span></span></div>
<div id="mo-initial-loader" role="status" aria-label="Carregando sistema"><div id="mo-initial-track" class="config-preview-track"><span></span></div><img class="mo-loader-logo-light" src="<%= baseUrl('public/images/hst-logo.png') %>" alt=""><img class="mo-loader-logo-dark" src="<%= baseUrl('public/images/logo-icone-branco.png') %>" alt=""><svg class="mo-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" class="mo-spinner-arc"/></svg><span class="sr-only">Carregando sistema</span></div>
<aside id="app-sidebar" class="app-sidebar fixed left-0 top-0 h-full flex flex-col pt-4 pb-8 z-40 bg-surface border-r border-border-subtle">
  <div class="sidebar-top px-4 mb-8 flex items-center justify-between gap-2">
    <div class="sidebar-brand flex items-center gap-3 min-w-0">
      <img src="<%= baseUrl('public/images/hst-logo.png') %>" alt="Medicina Ocupacional" class="sidebar-logo sidebar-logo-light h-11 w-11 object-contain"><img src="<%= baseUrl('public/images/logo-icone-branco.png') %>" alt="" class="sidebar-logo sidebar-logo-dark h-11 w-11 object-contain">
      <div class="sidebar-brand-text flex flex-col">
        <h1 class="text-base font-semibold text-primary leading-tight whitespace-nowrap">Medicina</h1>
        <p class="text-on-surface-variant text-[11px] tracking-wider uppercase font-semibold mt-1">Gestão Ocupacional</p>
      </div>
    </div>
    <button id="sidebar-toggle" type="button" onclick="alternarMenuLateral()" class="sidebar-toggle" aria-label="Fechar barra lateral" aria-expanded="true">
      <span id="sidebar-toggle-icon" data-ui-icon="collapse"></span>
      <span id="sidebar-toggle-tooltip" class="sidebar-hover-tooltip sidebar-toggle-tooltip">Fechar barra lateral</span>
    </button>
  </div>
  <nav class="sidebar-nav flex-1 px-3 space-y-1">
    <% const links = [
      { href: '', icon: 'dashboard', label: 'Painel', key: 'dashboard' },
      { href: 'setores', icon: 'building', label: 'Setores', key: 'setores' },
      { href: 'cargos', icon: 'briefcase', label: 'Cargos', key: 'cargos' },
      { href: 'funcionarios', icon: 'users', label: 'Funcionários', key: 'funcionarios' },
      { href: 'riscos', icon: 'alert', label: 'Riscos', key: 'riscos' },
      { href: 'exames-complementares', icon: 'microscope', label: 'Exames', key: 'exames-complementares' },
      { href: 'perguntas-anamnese', icon: 'checklist', label: 'Anamnese', key: 'perguntas-anamnese' },
      { href: 'relacionamento', icon: 'branch', label: 'Relacionamento', key: 'relacionamento' },
      { href: 'historico', icon: 'fileText', label: 'Registros', key: 'registros-ocupacionais' }
      ,{ href: 'indicadores', icon: 'chart', label: 'Indicadores', key: 'indicadores' }
    ]; %>
    <% links.forEach(l => { %>
      <a href="<%= baseUrl(l.href) %>" aria-label="<%= l.label %>" <%= active === l.key ? 'aria-current="page"' : '' %> class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg font-body-md text-body-md transition-all <%= active === l.key ? 'sidebar-link-active' : 'text-on-surface-variant hover:bg-surface-container-low' %>">
        <span data-ui-icon="<%= l.icon %>"></span>
        <span class="sidebar-label"><%= l.label %></span>
        <span class="sidebar-hover-tooltip"><%= l.label %></span>
      </a>
    <% }) %>
  </nav>
  <div class="sidebar-pdf-wrap px-4 mt-6">
    <a href="<%= baseUrl('gerar-pdf') %>" title="Gerar novo ASO" data-tooltip="Gerar novo ASO" class="sidebar-pdf w-full py-3 px-4 bg-primary text-white font-bold rounded-lg hover:opacity-90 transition-all flex items-center justify-center gap-2">
      <span data-ui-icon="fileText"></span>
      <span class="sidebar-pdf-label">Gerar novo ASO</span>
    </a>
  </div>
</aside>
<button type="button" class="mobile-sidebar-backdrop" onclick="fecharMenuMobile()" aria-label="Fechar menu lateral"></button>

<main class="app-main flex flex-col min-h-screen">
  <header class="flex justify-between items-center w-full px-gutter h-16 sticky top-0 z-30 bg-surface border-b border-border-subtle">
    <div class="flex items-center gap-3 min-w-0">
      <button type="button" onclick="abrirMenuMobile()" class="md:hidden w-9 h-9 shrink-0 rounded-lg flex items-center justify-center text-on-surface-variant hover:bg-surface-container-low" aria-label="Abrir menu lateral"><span data-ui-icon="menu"></span></button>
      <h2 class="font-headline-md text-headline-md font-semibold text-on-surface"><%= typeof pageTitle !== 'undefined' ? pageTitle : '' %></h2>
    </div>
    <div class="flex items-center gap-3">
      <button id="theme-toggle" type="button" onclick="alternarTema()" title="Alternar tema" aria-label="Usar tema escuro" class="p-2 rounded-full text-on-surface-variant hover:bg-surface-container-low transition-colors">
        <span id="theme-toggle-icon" data-ui-icon="moon"></span>
      </button>
      <a href="<%= baseUrl('relatorios') %>" title="Central de relatórios" aria-label="Central de relatórios" class="p-2 rounded-full text-on-surface-variant hover:bg-surface-container-low transition-colors <%= active === 'relatorios' ? 'bg-secondary-container text-primary' : '' %>">
        <span data-ui-icon="printer"></span>
      </a>
      <a href="<%= baseUrl('configuracoes') %>" title="Configurações" aria-label="Configurações" class="p-2 rounded-full transition-colors <%= active === 'configuracoes' ? 'bg-secondary-container text-primary' : 'text-on-surface-variant hover:bg-surface-container-low' %>">
        <span data-ui-icon="settings"></span>
      </a>
      <div class="hidden sm:flex items-center gap-2 pl-3 border-l border-border-subtle">
        <span class="hidden md:block text-right leading-tight"><span id="nav-medico" class="block text-body-md font-semibold text-on-surface">Médico coordenador</span><span id="nav-especialidade" class="block text-[11px] text-on-surface-variant">Medicina do Trabalho</span></span>
        <span title="Médico coordenador" class="w-9 h-9 rounded-full bg-primary-fixed text-primary flex items-center justify-center border border-primary-fixed-dim">
          <span id="nav-avatar-iniciais" class="text-[11px] font-bold">MC</span>
        </span>
      </div>
    </div>
  </header>
  <div id="toast-container" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 space-y-2"></div>
  <div class="p-gutter flex-1">

<script>
function aplicarEstadoMenuLateral() {
  const recolhido = document.documentElement.classList.contains('sidebar-collapsed');
  const icone = document.getElementById('sidebar-toggle-icon');
  const botao = document.getElementById('sidebar-toggle');
  if (icone) { icone.dataset.uiIcon = 'collapse'; renderUiIcons(icone.parentElement); }
  if (botao) {
    const texto = recolhido ? 'Abrir barra lateral' : 'Fechar barra lateral';
    botao.setAttribute('aria-label', texto);
    botao.setAttribute('aria-expanded', String(!recolhido));
    const tooltip = document.getElementById('sidebar-toggle-tooltip');
    if (tooltip) tooltip.textContent = texto;
  }
}

function alternarMenuLateral() {
  if (window.matchMedia('(max-width: 767px)').matches) {
    fecharMenuMobile();
    return;
  }
  document.documentElement.classList.toggle('sidebar-collapsed');
  const recolhido = document.documentElement.classList.contains('sidebar-collapsed');
  try { localStorage.setItem('medicinaSidebarCollapsed', String(recolhido)); } catch (_) {}
  aplicarEstadoMenuLateral();
}

function abrirMenuMobile() {
  document.documentElement.classList.add('mobile-sidebar-open');
}

function fecharMenuMobile() {
  document.documentElement.classList.remove('mobile-sidebar-open');
}

document.querySelectorAll('.sidebar-link, .sidebar-pdf').forEach(link => link.addEventListener('click', fecharMenuMobile));

function aplicarTema() {
  const escuro = document.documentElement.classList.contains('dark');
  const icone = document.getElementById('theme-toggle-icon');
  const botao = document.getElementById('theme-toggle');
  if (icone) { icone.dataset.uiIcon = escuro ? 'sun' : 'moon'; renderUiIcons(icone.parentElement); }
  if (botao) botao.setAttribute('aria-label', escuro ? 'Usar tema claro' : 'Usar tema escuro');
}

function alternarTema() {
  document.documentElement.classList.toggle('dark');
  try { localStorage.setItem('medicinaTheme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); } catch (_) {}
  aplicarTema();
}

aplicarEstadoMenuLateral();
aplicarTema();

api('config').then(config => {
  const medico = document.getElementById('nav-medico');
  const especialidade = document.getElementById('nav-especialidade');
  if (medico && config.Medico) medico.textContent = config.Medico;
  if (especialidade && config.Especialidade) especialidade.textContent = config.Especialidade;
  const avatar = document.getElementById('nav-avatar-iniciais');
  if (avatar && config.Medico) avatar.textContent = config.Medico.replace(/^Dr\.?\s*/i, '').trim().split(/\s+/).slice(0, 2).map(parte => parte[0]).join('').toUpperCase() || 'MC';
}).catch(() => {});

</script>
