  .dark .divide-border-subtle>:not([hidden])~:not([hidden]){border-color:var(--dark-line)!important}
  .dark :is(thead,.approved-data-card thead,.modern-table thead th,.approved-data-card thead th){background:var(--dark-page)!important}
  .dark table thead th{color:var(--dark-muted)!important}
  .dark :is(tbody tr:hover,.approved-data-card tbody tr:hover,.modern-table tbody tr:hover){background:var(--dark-hover)!important}
  .dark .modern-table tbody tr{background:var(--dark-card)!important}
  .dark .modern-table tbody td{background:transparent!important;border-color:var(--dark-line)!important;color:var(--dark-text)!important}
  .dark :is(.approved-button:not(.primary),.modal-cancel-button,.modern-pagination button:not(.bg-primary)){background:var(--dark-card)!important;border-color:var(--dark-line)!important;color:var(--dark-text)!important}
  .dark :is(.approved-button:not(.primary),.modal-cancel-button,.modern-pagination button:not(.bg-primary)):hover{background:var(--dark-hover)!important;border-color:#454545!important}
  .dark .modern-tab{color:var(--dark-muted)!important}
  .dark .modern-tab.active{color:#38c8bb!important;border-color:#38c8bb!important}
  .dark .modern-count{background:var(--dark-hover)!important;color:var(--dark-text)!important}
  .dark :is(.sidebar-pdf,.approved-button.primary,.modern-primary){background:#075cae!important;border-color:#075cae!important;color:#fff!important}
  .dark :is(.sidebar-pdf,.approved-button.primary,.modern-primary):hover{background:#096bc6!important}
  .dark :is(.text-primary,.approved-action){color:#84b6ff!important}
  .dark :is(.text-green-700,.text-green-800){color:#73d99a!important}
  .dark :is(.hover\:bg-primary-fixed:hover,.hover\:bg-surface-container-low:hover,.approved-action:hover){background:var(--dark-hover)!important}
  .dark :is(.bg-primary-fixed,.modern-metric-icon){background:var(--dark-hover)!important;color:#84b6ff!important}
  .dark :is(.employee-table .mobile-row-actions-menu,.table-mobile-actions-menu){background:var(--dark-card)!important;border-color:var(--dark-line)!important}
  .dark :is(.employee-table .mobile-row-actions-menu button:hover,.table-mobile-actions-menu>button:hover,.table-mobile-actions-menu>a:hover){background:var(--dark-hover)!important}
  .dark .modal-backdrop{background:rgba(0,0,0,.62)!important}
  .dark .modal-backdrop :is(.modern-surface,.modern-control){background:var(--dark-card)!important;border-color:var(--dark-line)!important;color:var(--dark-text)!important}
  .dark :is(.approved-quick-links a,.approved-quick-links a:nth-child(2),.approved-quick-links a:nth-child(3),.approved-quick-links a:nth-child(4)){background:var(--dark-card)!important;border-color:var(--dark-line)!important;color:var(--dark-text)!important}
  .dark .approved-quick-links a:hover{background:var(--dark-hover)!important}
  .dark .approved-quick-links small{color:var(--dark-muted)!important}
  .dark .approved-quick-links a>span{background:var(--dark-hover)!important;color:#84b6ff!important}
  .dark .report-paper,.dark .report-paper header{background:#fff!important;color:#111827!important}
</style>
