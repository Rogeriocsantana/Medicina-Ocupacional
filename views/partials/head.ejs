<style id="pesquisa-pacientes-dark-system">
  /* Pesquisa Pacientes: página < cards/controles < hover, com cor apenas como acento. */
  .dark {
    --dark-page:#202020;
    --dark-sidebar:#242424;
    --dark-card:#292929;
    --dark-hover:#303030;
    --dark-line:#3a3a3a;
