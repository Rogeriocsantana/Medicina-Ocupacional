  sliders: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  moreVertical: '<circle cx="12" cy="5" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="19" r="1" fill="currentColor" stroke="none"/>',
  pencil: '<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  trash: '<path d="M3 6h18M8 6V4h8v2M19 6l-1 15H6L5 6M10 11v6M14 11v6"/>'
});
function renderUiIcons(root = document) { root.querySelectorAll('[data-ui-icon]').forEach(el => { const path = UI_ICON_PATHS[el.dataset.uiIcon]; if (path) el.innerHTML = `<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true">${path}</svg>`; }); }

function fecharMenusAcoesTabelas(excecao = null) {
  document.querySelectorAll('.table-mobile-actions-menu').forEach(menu => {
    if (menu !== excecao) menu.classList.add('hidden');
  });
}

function alternarMenuAcoesTabela(event, botao) {
  event.stopPropagation();
  const menu = botao.nextElementSibling;
  fecharMenusAcoesTabelas(menu);
  menu.classList.toggle('hidden');
}

function rotuloAcaoMobile(acao) {
  const explicito = acao.getAttribute('title') || acao.getAttribute('aria-label');
  if (explicito) return explicito;
  const tecnico = normalizeSearchText(acao.textContent).replace(/\s+/g, '_');
  const rotulos = {
    edit: 'Editar', delete: 'Excluir', group: 'Colaboradores', groups: 'Colaboradores',
    person: 'Colaborador', people: 'Colaboradores', download: 'Baixar', refresh: 'Atualizar',
    update: 'Atualizar', visibility: 'Visualizar', open_in_new: 'Abrir', content_copy: 'Copiar',
    restore: 'Restaurar', description: 'Documento', picture_as_pdf: 'Baixar PDF'
  };
  return rotulos[tecnico] || 'Abrir';
}

function aprimorarAcoesTabelas(root = document) {
  const tabelas = root.matches?.('table') ? [root] : Array.from(root.querySelectorAll?.('table') || []);
  tabelas.forEach(tabela => {
    const cabecalhos = tabela.querySelectorAll('thead th');
    if (!cabecalhos.length) return;
    const ultimoCabecalho = cabecalhos[cabecalhos.length - 1];
    const titulo = normalizeSearchText(ultimoCabecalho.textContent).replace(/[^a-z]/g, '');
    if (titulo !== 'acao' && titulo !== 'acoes') return;
    ultimoCabecalho.classList.add('table-action-header');
    tabela.querySelectorAll('tbody tr').forEach(linha => {
      const celulas = linha.querySelectorAll(':scope > td');
      const celula = celulas[celulas.length - 1];
      if (!celula || celula.dataset.kebabEnhanced === 'true' || celula.querySelector('.mobile-row-actions')) return;
      const acoes = Array.from(celula.querySelectorAll('button, a'));
      if (!acoes.length) return;
      celula.dataset.kebabEnhanced = 'true';
      celula.classList.add('relative');
      const desktop = document.createElement('div');
      desktop.className = 'table-desktop-actions';
      while (celula.firstChild) desktop.appendChild(celula.firstChild);
      celula.appendChild(desktop);
      const mobile = document.createElement('div');
      mobile.className = 'table-mobile-actions';
      const gatilho = document.createElement('button');
      gatilho.type = 'button';
      gatilho.className = 'p-1.5 text-on-surface-variant rounded hover:bg-surface-container-low';
      gatilho.setAttribute('aria-label', 'Abrir ações');
      gatilho.setAttribute('data-ui-icon', 'moreVertical');
      gatilho.addEventListener('click', event => alternarMenuAcoesTabela(event, gatilho));
      const menu = document.createElement('div');
      menu.className = 'table-mobile-actions-menu hidden';
      acoes.forEach(acao => {
        const copia = acao.cloneNode(true);
        const rotulo = rotuloAcaoMobile(acao);
        copia.removeAttribute('title');
        const textoVisivel = Array.from(copia.childNodes).some(no => {
          if (no.nodeType === 3) return no.textContent.trim();
          if (no.nodeType !== 1) return false;
          return !no.matches('.material-symbols-outlined, [data-ui-icon]') && no.textContent.trim();
        });
        if (!textoVisivel) {
          const texto = document.createElement('span');
          texto.textContent = rotulo;
          copia.appendChild(texto);
        }
        copia.addEventListener('click', fecharMenusAcoesTabelas);
        menu.appendChild(copia);
      });
      mobile.append(gatilho, menu);
      celula.appendChild(mobile);
      renderUiIcons(mobile);
    });
  });
}

document.addEventListener('click', () => fecharMenusAcoesTabelas());
document.addEventListener('DOMContentLoaded', () => {
  renderUiIcons();
  aprimorarAcoesTabelas();
  new MutationObserver(mudancas => mudancas.forEach(mudanca => mudanca.addedNodes.forEach(no => {
    if (no.nodeType === 1) aprimorarAcoesTabelas(no.closest?.('table') || no);
  }))).observe(document.body, { childList: true, subtree: true });
});

function appUrl(path = '') {
  const cleanPath = String(path || '').replace(/^\/+/, '');
  if (!cleanPath) return BASE_PATH ? `${BASE_PATH}/` : '/';
  return `${BASE_PATH}/${cleanPath}`;
}

function apiUrl(path = '') {
  const cleanPath = String(path || '').replace(/^\/+/, '');
  return appUrl(cleanPath ? `api/${cleanPath}` : 'api');
}

async function api(path, options = {}) {
  const res = await fetch(apiUrl(path), {
    headers: { 'Content-Type': 'application/json' },
    cache: 'no-store',
    ...options
  });
  let data = null;
  try { data = await res.json(); } catch (e) { /* sem corpo */ }
  if (!res.ok) {
    const msg = (data && data.erro) ? data.erro : `Erro na requisição (${res.status})`;
    throw new Error(msg);
  }
  return data;
}

function toast(mensagem, tipo = 'sucesso') {
  const container = document.getElementById('toast-container');
  if (!container) return alert(mensagem);
  const bg = tipo === 'erro' ? 'bg-error text-white' : 'bg-primary text-white';
  const el = document.createElement('div');
  el.className = `${bg} px-4 py-3 rounded-lg shadow-lg font-body-md text-body-md max-w-sm`;
  el.textContent = mensagem;
  container.appendChild(el);
  setTimeout(() => el.remove(), 3500);
}

function confirmarExclusao(mensagem) {
  return window.confirm(mensagem || 'Tem certeza que deseja excluir este registro?');
}

function htmlPaginacao(pagina, totalItens, porPagina, funcao) {
  const totalPaginas = Math.max(1, Math.ceil(totalItens / porPagina));
  if (totalPaginas <= 1) return '';
  const inicio = (pagina - 1) * porPagina + 1;
  const fim = Math.min(pagina * porPagina, totalItens);
  const botoes = Array.from({ length: totalPaginas }, (_, i) => i + 1)
    .filter(n => totalPaginas <= 7 || n === 1 || n === totalPaginas || Math.abs(n - pagina) <= 1)
    .map((n, i, arr) => `${i && n - arr[i - 1] > 1 ? '<span class="px-1 text-on-surface-variant">…</span>' : ''}<button type="button" onclick="${funcao}(${n})" class="min-w-8 h-8 px-2 rounded text-sm font-semibold ${n === pagina ? 'bg-primary text-white' : 'text-on-surface hover:bg-surface-container-low'}">${n}</button>`).join('');
  const setaAnterior = '<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>';
  const setaProxima = '<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
  return `<div class="modern-pagination flex flex-wrap gap-3 justify-between items-center"><p class="text-table-data text-on-surface-variant">Mostrando ${inicio}–${fim} de ${totalItens}</p><div class="flex items-center gap-1"><button type="button" aria-label="Página anterior" onclick="${funcao}(${pagina - 1})" ${pagina === 1 ? 'disabled' : ''} class="w-8 h-8 border border-border-subtle disabled:opacity-40 hover:bg-surface-container-low inline-flex items-center justify-center">${setaAnterior}</button>${botoes}<button type="button" aria-label="Próxima página" onclick="${funcao}(${pagina + 1})" ${pagina === totalPaginas ? 'disabled' : ''} class="w-8 h-8 border border-border-subtle disabled:opacity-40 hover:bg-surface-container-low inline-flex items-center justify-center">${setaProxima}</button></div></div>`;
}

function escapeHtml(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function onlyDigits(value) {
  return String(value || '').replace(/\D/g, '');
}

function formatCpf(value) {
  const d = onlyDigits(value).slice(0, 11);
  if (d.length <= 3) return d;
  if (d.length <= 6) return d.slice(0, 3) + '.' + d.slice(3);
  if (d.length <= 9) return d.slice(0, 3) + '.' + d.slice(3, 6) + '.' + d.slice(6);
  return d.slice(0, 3) + '.' + d.slice(3, 6) + '.' + d.slice(6, 9) + '-' + d.slice(9);
}

function isValidCpf(value) {
  const cpf = onlyDigits(value);
  if (cpf.length !== 11) return false;
  if (/^(\d)\1{10}$/.test(cpf)) return false;
  let sum = 0;
  for (let i = 0; i < 9; i++) sum += Number(cpf[i]) * (10 - i);
  let rest = (sum * 10) % 11;
  if (rest === 10) rest = 0;
  if (rest !== Number(cpf[9])) return false;
  sum = 0;
  for (let i = 0; i < 10; i++) sum += Number(cpf[i]) * (11 - i);
  rest = (sum * 10) % 11;
  if (rest === 10) rest = 0;
  return rest === Number(cpf[10]);
}

function bindCpfMask(input) {
  if (!input) return;
  input.setAttribute('inputmode', 'numeric');
  input.setAttribute('maxlength', '14');
  input.setAttribute('autocomplete', 'off');
  input.addEventListener('input', () => {
    const start = input.selectionStart;
    const before = input.value.length;
    input.value = formatCpf(input.value);
    const after = input.value.length;
    if (typeof start === 'number') {
      const next = Math.max(0, start + (after - before));
      try { input.setSelectionRange(next, next); } catch (_) {}
    }
  });
}

// Select pesquisável compartilhado: mantém o <select> original como fonte do
// valor e adiciona uma interface acessível, ordenada e filtrável.
function normalizeSearchText(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLocaleLowerCase('pt-BR')
    .trim();
}

function enhanceSearchableSelect(select) {
  if (!select || select.dataset.searchableEnhanced === 'true' || select.multiple) return;
  select.dataset.searchableEnhanced = 'true';

  const wrapper = document.createElement('div');
  wrapper.className = `relative min-w-0 ${select.classList.contains('w-full') ? 'w-full' : ''} ${select.classList.contains('flex-1') ? 'flex-1' : ''}`;
  select.parentNode.insertBefore(wrapper, select);
  wrapper.appendChild(select);
  select.classList.add('sr-only');

  const trigger = document.createElement('button');
  trigger.type = 'button';
  trigger.className = `${select.className.replace(/\bsr-only\b/g, '')} min-w-0 text-left flex items-center justify-between gap-2`;
  trigger.setAttribute('aria-haspopup', 'listbox');
  trigger.innerHTML = '<span class="truncate"></span><span class="material-symbols-outlined shrink-0">expand_more</span>';
  wrapper.appendChild(trigger);

  const menu = document.createElement('div');
  menu.className = 'searchable-select-menu fixed z-[100] hidden overflow-hidden rounded-lg border border-border-subtle bg-surface';
  menu.innerHTML = `
    <div class="sticky top-0 z-10 bg-surface p-2 border-b border-border-subtle">
      <div class="relative">
        <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
        <input type="search" placeholder="Buscar..." class="searchable-select-search w-full rounded-md border border-border-subtle py-2 pl-9 pr-3 text-sm focus:ring-2 focus:ring-primary">
      </div>
    </div>
    <div class="searchable-select-options overflow-y-auto py-1" role="listbox"></div>`;
  document.body.appendChild(menu);
  const search = menu.querySelector('.searchable-select-search');
  const optionsBox = menu.querySelector('.searchable-select-options');

  function sortedOptions() {
    const all = Array.from(select.options);
    const placeholders = all.filter(option => !option.value);
    const values = all.filter(option => option.value).sort((a, b) =>
      a.textContent.trim().localeCompare(b.textContent.trim(), 'pt-BR', { sensitivity: 'base', numeric: true })
    );
    const ordered = [...placeholders, ...values];
    if (ordered.some((option, index) => option !== all[index])) ordered.forEach(option => select.appendChild(option));
    return ordered;
  }

  function syncTrigger() {
    const selected = select.options[select.selectedIndex];
    trigger.querySelector('span').textContent = selected ? (selected.dataset.triggerLabel || selected.textContent.trim()) : 'Selecione...';
    trigger.disabled = select.disabled;
    trigger.setAttribute('aria-expanded', menu.classList.contains('hidden') ? 'false' : 'true');
  }

  function renderOptions(query = '') {
    const normalizedQuery = normalizeSearchText(query);
    const filtered = sortedOptions().filter(option =>
      !normalizedQuery || normalizeSearchText(option.textContent).includes(normalizedQuery)
    );
    optionsBox.innerHTML = filtered.map(option => `
      <button type="button" role="option" class="searchable-select-option block w-full px-3 py-2 text-left text-sm hover:bg-surface-container-low disabled:opacity-50"
        data-value="${escapeHtml(option.value)}" aria-selected="${String(option.value) === String(select.value)}" ${option.disabled ? 'disabled' : ''}>
        ${escapeHtml(option.textContent.trim())}
      </button>`).join('') || '<p class="px-3 py-3 text-sm text-on-surface-variant">Nenhuma opção encontrada.</p>';
  }

  function positionMenu() {
    const rect = trigger.getBoundingClientRect();
    const below = window.innerHeight - rect.bottom;
    const openAbove = below < 220 && rect.top > below;
    const available = openAbove ? rect.top : below;
    const maxHeight = Math.max(180, Math.min(360, available - 12));
    const medidor = document.createElement('canvas').getContext('2d');
    medidor.font = window.getComputedStyle(trigger).font;
    const larguraMaiorOpcao = Array.from(select.options).reduce((maior, option) =>
      Math.max(maior, medidor.measureText(option.textContent.trim()).width), 0);
    const menuWidth = Math.min(Math.max(rect.width, Math.ceil(larguraMaiorOpcao + 48)), window.innerWidth - 16);
    const menuLeft = Math.min(Math.max(8, rect.left), Math.max(8, window.innerWidth - menuWidth - 8));
    menu.style.left = `${menuLeft}px`;
    menu.style.top = `${openAbove ? Math.max(8, rect.top - maxHeight - 4) : rect.bottom + 4}px`;
    menu.style.width = `${menuWidth}px`;
    menu.style.maxHeight = `${maxHeight}px`;
    optionsBox.style.maxHeight = `${maxHeight - 58}px`;
  }

  function closeMenu() {
    menu.classList.add('hidden');
    trigger.setAttribute('aria-expanded', 'false');
  }

  function openMenu() {
    document.querySelectorAll('.searchable-select-menu:not(.hidden)').forEach(other => {
      if (other !== menu) other.classList.add('hidden');
    });
    syncTrigger();
    renderOptions('');
    positionMenu();
    menu.classList.remove('hidden');
    trigger.setAttribute('aria-expanded', 'true');
    search.value = '';
    setTimeout(() => search.focus(), 0);
  }

  trigger.addEventListener('click', () => menu.classList.contains('hidden') ? openMenu() : closeMenu());
  search.addEventListener('input', () => renderOptions(search.value));
  search.addEventListener('keydown', event => { if (event.key === 'Escape') { closeMenu(); trigger.focus(); } });
  optionsBox.addEventListener('click', event => {
    const option = event.target.closest('[data-value]');
    if (!option) return;
    select.value = option.dataset.value;
    select.dispatchEvent(new Event('change', { bubbles: true }));
    syncTrigger();
    closeMenu();
    trigger.focus();
  });
  select.addEventListener('change', syncTrigger);
  select.addEventListener('invalid', event => {
    event.preventDefault();
    openMenu();
  });
  window.addEventListener('resize', () => { if (!menu.classList.contains('hidden')) positionMenu(); });
  window.addEventListener('scroll', event => {
    if (!menu.contains(event.target)) closeMenu();
  }, true);
  document.addEventListener('click', event => {
    if (!wrapper.contains(event.target) && !menu.contains(event.target)) closeMenu();
  });

  const valueDescriptor = Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype, 'value');
  if (valueDescriptor && valueDescriptor.get && valueDescriptor.set) {
    Object.defineProperty(select, 'value', {
      configurable: true,
      get() { return valueDescriptor.get.call(this); },
      set(value) { valueDescriptor.set.call(this, value); syncTrigger(); }
    });
  }
  new MutationObserver(() => { renderOptions(search.value); syncTrigger(); })
    .observe(select, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['disabled'] });
  select.form?.addEventListener('reset', () => setTimeout(syncTrigger, 0));
  renderOptions();
  syncTrigger();
}

function enhanceAllSearchableSelects(root = document) {
  root.querySelectorAll('select').forEach(enhanceSearchableSelect);
}

document.addEventListener('DOMContentLoaded', () => {
  enhanceAllSearchableSelects();
  new MutationObserver(mutations => mutations.forEach(mutation => mutation.addedNodes.forEach(node => {
    if (!(node instanceof Element)) return;
    if (node.matches('select')) enhanceSearchableSelect(node);
    enhanceAllSearchableSelects(node);
  }))).observe(document.body, { childList: true, subtree: true });
});

async function downloadPdfFromResponse(res, fallbackName = 'ASO.pdf') {
  if (!res.ok) {
    let data = null;
    try { data = await res.json(); } catch (_) {}
    throw new Error((data && data.erro) || `Erro na requisição (${res.status})`);
  }
  const disposition = res.headers.get('Content-Disposition') || '';
  const match = disposition.match(/filename="?([^"]+)"?/i);
  const filename = match ? match[1] : fallbackName;
  const blob = await res.blob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}
</script>
