  .modern-title { font-size: 26px; line-height: 32px; letter-spacing: -.025em; font-weight: 600; }
  .modern-subtitle { color: #707989; font-size: 13px; line-height: 20px; }
  .modern-surface { background: #fff; border: 1px solid #e4e8f0; border-radius: 14px; }
  .modern-metric { padding: 17px; }
