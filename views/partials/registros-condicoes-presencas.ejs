<section id="painel-condicoes" class="hidden approved-data-card">
  <p id="condicoes-pendentes-aviso" class="hidden px-4 py-3 text-sm text-primary bg-blue-50 border-b border-border-subtle"></p>
  <div class="overflow-x-auto"><table class="w-full min-w-[700px] text-left"><thead><tr><th aria-sort="ascending" id="condicoes-ordem-nome"><button type="button" class="inline-flex items-center gap-1" onclick="ordenarCondicoes('nome')">Funcionário <span id="condicoes-seta-nome" aria-hidden="true">↑</span></button></th><th>Condição</th><th aria-sort="none" id="condicoes-ordem-inicio"><button type="button" class="inline-flex items-center gap-1" onclick="ordenarCondicoes('inicio')">Início <span id="condicoes-seta-inicio" aria-hidden="true"></span></button></th><th>Fim</th><th class="text-right">Ações</th></tr></thead><tbody id="condicoes-lista"></tbody></table></div><div id="condicoes-paginacao"></div>
</section>
<section id="painel-presencas" class="hidden approved-data-card">
  <div class="overflow-x-auto"><table class="w-full min-w-[450px] text-left"><thead><tr><th>Data</th><th>Observação</th><th class="text-right">Ações</th></tr></thead><tbody id="presencas-lista"></tbody></table></div><div id="presencas-paginacao"></div>
</section>
<div id="modal-condicao" class="hidden fixed inset-0 z-50 modal-backdrop p-4 items-center justify-center"><div class="modern-surface w-full max-w-2xl p-5 max-h-[92vh] overflow-y-auto">
  <div class="flex justify-between items-center mb-4"><h3 id="titulo-modal-condicao" class="text-xl font-semibold">Nova condição</h3><button type="button" onclick="fecharEspecial('condicao')" aria-label="Fechar"><span data-ui-icon="close"></span></button></div>
  <form id="form-condicao-registro" class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <input id="condicao-registro-id" type="hidden">
    <label class="md:col-span-2 text-sm font-medium">Funcionário<div class="relative mt-1"><span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span><input id="condicao-funcionario-busca" required autocomplete="off" placeholder="Buscar por nome ou CPF..." class="modern-control pl-10 pr-4 w-full"><input id="condicao-funcionario" type="hidden"><div id="condicao-sugestoes" class="hidden absolute z-30 left-0 right-0 mt-1 bg-surface border border-border-subtle rounded-lg shadow-lg max-h-56 overflow-y-auto"></div></div></label>
    <label class="text-sm font-medium">Condição<select id="condicao-tipo" required class="modern-control px-3 mt-1 w-full"><option value="">Selecione</option><option>FÉRIAS</option><option>GESTANTE</option><option>PUERPÉRIO</option><option>LICENÇA MÉDICA</option><option>AFASTADO</option><option>OUTRA</option></select></label>
    <label class="text-sm font-medium">Data de início<input id="condicao-inicio" required type="date" class="modern-control px-3 mt-1 w-full"></label>
    <label class="text-sm font-medium">Data de fim <span class="text-on-surface-variant font-normal">(opcional)</span><input id="condicao-fim" type="date" class="modern-control px-3 mt-1 w-full"></label>
    <label class="md:col-span-2 text-sm font-medium">Observação<textarea id="condicao-observacao" class="modern-control px-3 py-2 mt-1 w-full" rows="2" placeholder="Opcional"></textarea></label>
    <div class="md:col-span-2 flex justify-end gap-2 mt-3"><button type="button" class="modern-control px-4" onclick="fecharEspecial('condicao')">Cancelar</button><button class="modern-primary px-5 py-2.5">Salvar condição</button></div>
  </form>
</div></div>
<div id="modal-presenca" class="hidden fixed inset-0 z-50 modal-backdrop p-4 items-center justify-center"><div class="modern-surface w-full max-w-lg p-5">
  <div class="flex justify-between items-center mb-4"><h3 id="titulo-modal-presenca" class="text-xl font-semibold">Nova presença médica</h3><button type="button" onclick="fecharEspecial('presenca')" aria-label="Fechar"><span data-ui-icon="close"></span></button></div>
  <form id="form-presenca-registro" class="space-y-3"><input id="presenca-registro-id" type="hidden">
    <label class="text-sm font-medium block">Data<input id="presenca-data" required type="date" class="modern-control px-3 mt-1 w-full"></label>
    <label class="text-sm font-medium block">Observação<textarea id="presenca-observacao" class="modern-control px-3 py-2 mt-1 w-full" rows="3" placeholder="Opcional"></textarea></label>
    <div class="flex justify-end gap-2 pt-3"><button type="button" class="modern-control px-4" onclick="fecharEspecial('presenca')">Cancelar</button><button class="modern-primary px-5 py-2.5">Salvar presença</button></div>
  </form>
</div></div>
<div id="modal-encerrar-condicao" class="hidden fixed inset-0 z-50 modal-backdrop p-4 items-center justify-center"><div class="modern-surface w-full max-w-lg p-5">
  <h3 class="text-xl font-semibold mb-2">Encerrar condição</h3>
  <p class="text-on-surface-variant mb-4">A data de fim será registrada no histórico e a condição deixará de aparecer no cadastro do funcionário.</p>
  <form id="form-encerrar-condicao" class="space-y-4"><input id="encerrar-condicao-id" type="hidden"><label class="block font-medium">Data de fim<input id="encerrar-condicao-data" type="date" required class="modern-control px-3 mt-1 w-full"></label><div class="flex justify-end gap-2"><button type="button" class="modern-control px-4" onclick="fecharEspecial('encerrar-condicao')">Cancelar</button><button class="modern-primary px-5 py-2.5">Encerrar</button></div></form>
</div></div>
<script>
let listaCondicoes=[],listaPresencas=[],paginaCondicoes=1,paginaPresencas=1,buscaCondicaoTimer,ordenacaoCondicoes='nome-asc';
const porPaginaEspecial=5;
function periodoRegistro(){const q=new URLSearchParams(),ano=Number(document.getElementById('filtro-ano').value),mes=Number(document.getElementById('filtro-mes').value);if(ano){q.set('inicio',mes?ano+'-'+String(mes).padStart(2,'0')+'-01':ano+'-01-01');q.set('fim',mes?ano+'-'+String(mes).padStart(2,'0')+'-'+new Date(ano,mes,0).getDate():ano+'-12-31')}return q}
async function carregarCondicoes(){try{const q=periodoRegistro(),condicao=document.getElementById('filtro-condicao').value;if(condicao)q.set('condicao',condicao);listaCondicoes=await api('condicoes?'+q);paginaCondicoes=1;const total=listaCondicoes.filter(r=>r.pendente_data).length,aviso=document.getElementById('condicoes-pendentes-aviso');aviso.classList.toggle('hidden',!total);aviso.textContent=total+' funcionário(s) com condição no cadastro e data de início pendente. Edite cada registro para completar o histórico e atualizar os relatórios.';renderCondicoes()}catch(error){toast(error.message,'erro')}}
async function carregarPresencas(){try{listaPresencas=await api('presencas-medicas?'+periodoRegistro());paginaPresencas=1;renderPresencas()}catch(error){toast(error.message,'erro')}}
function acaoEspecial(func,id,icone,titulo,perigo){return '<button type="button" onclick="'+func+'('+id+')" title="'+titulo+'" aria-label="'+titulo+'" class="inline-flex items-center justify-center w-8 h-8 rounded '+(perigo?'text-error hover:bg-error-container':'text-primary hover:bg-primary-fixed')+'"><span class="material-symbols-outlined" style="font-size:20px">'+icone+'</span></button>'}
function ordenarCondicoes(coluna){ordenacaoCondicoes=ordenacaoCondicoes.startsWith(coluna+'-')&&ordenacaoCondicoes.endsWith('asc')?coluna+'-desc':coluna+'-asc';paginaCondicoes=1;renderCondicoes()}
function renderCondicoes(){
  const termo=document.getElementById('filtro-busca').value.toLocaleLowerCase('pt-BR');
  const ordenacao=ordenacaoCondicoes;
  for(const coluna of ['nome','inicio']){const ativa=ordenacao.startsWith(coluna+'-');document.getElementById('condicoes-ordem-'+coluna).setAttribute('aria-sort',ativa?(ordenacao.endsWith('asc')?'ascending':'descending'):'none');document.getElementById('condicoes-seta-'+coluna).textContent=ativa?(ordenacao.endsWith('asc')?'↑':'↓'):''}
  const rows=listaCondicoes.filter(r=>[r.funcionario,r.cpf,r.empresa,r.condicao].some(v=>String(v||'').toLocaleLowerCase('pt-BR').includes(termo))).sort((a,b)=>{
    const nomes=String(a.funcionario||'').localeCompare(String(b.funcionario||''),'pt-BR');
    if(ordenacao==='nome-desc')return -nomes;
    if(ordenacao==='nome-asc')return nomes;
    const dataA=a.data_inicio?String(a.data_inicio).slice(0,10):'',dataB=b.data_inicio?String(b.data_inicio).slice(0,10):'';
    if(!dataA)return dataB?1:nomes;
    if(!dataB)return -1;
    return (ordenacao==='inicio-asc'?dataA.localeCompare(dataB):dataB.localeCompare(dataA))||nomes;
  });
  paginaCondicoes=Math.min(paginaCondicoes,Math.max(1,Math.ceil(rows.length/porPaginaEspecial)));
  const page=rows.slice((paginaCondicoes-1)*porPaginaEspecial,paginaCondicoes*porPaginaEspecial);
  document.getElementById('condicoes-lista').innerHTML=page.map(r=>{
    const actions=r.pendente_data
      ? acaoEspecial('editarCondicaoPendente',r.funcionario_id,'edit','Completar data')
      : acaoEspecial('editarCondicao',r.id,'edit','Editar')+(r.data_fim?'':acaoEspecial('encerrarCondicao',r.id,'event_available','Encerrar'))+acaoEspecial('excluirCondicao',r.id,'delete','Excluir lançamento',true);
    return '<tr><td><b>'+escapeHtml(r.funcionario)+'</b><small class="block modern-subtitle">CPF '+escapeHtml(formatCpf(r.cpf||''))+'</small></td><td>'+escapeHtml(r.condicao)+'</td><td>'+(r.pendente_data?'<span class="text-amber-700 font-semibold">Data pendente</span>':formatarData(r.data_inicio))+'</td><td>'+(r.pendente_data?'—':r.data_fim?formatarData(r.data_fim):'Ativa')+'</td><td class="text-right whitespace-nowrap">'+actions+'</td></tr>';
  }).join('')||'<tr><td colspan="5">Nenhuma condição registrada neste período.</td></tr>';
  document.getElementById('condicoes-paginacao').innerHTML=htmlPaginacao(paginaCondicoes,rows.length,porPaginaEspecial,'irPaginaCondicoes');
}
function renderPresencas(){const termo=document.getElementById('filtro-busca').value.toLocaleLowerCase('pt-BR');const rows=listaPresencas.filter(r=>[r.data_presenca,r.observacao].some(v=>String(v||'').toLocaleLowerCase('pt-BR').includes(termo)));paginaPresencas=Math.min(paginaPresencas,Math.max(1,Math.ceil(rows.length/porPaginaEspecial)));const page=rows.slice((paginaPresencas-1)*porPaginaEspecial,paginaPresencas*porPaginaEspecial);document.getElementById('presencas-lista').innerHTML=page.map(r=>'<tr><td>'+formatarData(r.data_presenca)+'</td><td>'+escapeHtml(r.observacao||'—')+'</td><td class="text-right whitespace-nowrap">'+acaoEspecial('editarPresenca',r.id,'edit','Editar')+acaoEspecial('excluirPresenca',r.id,'delete','Excluir',true)+'</td></tr>').join('')||'<tr><td colspan="3">Nenhuma presença registrada neste período.</td></tr>';document.getElementById('presencas-paginacao').innerHTML=htmlPaginacao(paginaPresencas,rows.length,porPaginaEspecial,'irPaginaPresencas')}
function irPaginaCondicoes(n){paginaCondicoes=n;renderCondicoes()}function irPaginaPresencas(n){paginaPresencas=n;renderPresencas()}
function fecharEspecial(tipo){const modal=document.getElementById('modal-'+tipo);modal.classList.add('hidden');modal.classList.remove('flex')}
function mostrarEspecial(tipo){const modal=document.getElementById('modal-'+tipo);modal.classList.remove('hidden');modal.classList.add('flex');renderUiIcons(modal)}
function abrirCondicao(r){document.getElementById('form-condicao-registro').reset();document.getElementById('condicao-registro-id').value=r?.id||'';document.getElementById('condicao-funcionario').value=r?.funcionario_id||'';document.getElementById('condicao-funcionario-busca').value=r?.funcionario||'';document.getElementById('condicao-tipo').value=r?.condicao||'';document.getElementById('condicao-inicio').value=r?.data_inicio?String(r.data_inicio).slice(0,10):'';document.getElementById('condicao-fim').value=r?.data_fim?String(r.data_fim).slice(0,10):'';document.getElementById('condicao-observacao').value=r?.observacao||'';document.getElementById('titulo-modal-condicao').textContent=r?.pendente_data?'Completar data da condição':r?'Editar condição':'Nova condição';document.getElementById('condicao-sugestoes').classList.add('hidden');mostrarEspecial('condicao')}
function abrirPresenca(r){document.getElementById('form-presenca-registro').reset();document.getElementById('presenca-registro-id').value=r?.id||'';document.getElementById('presenca-data').value=r?String(r.data_presenca).slice(0,10):'';document.getElementById('presenca-observacao').value=r?.observacao||'';document.getElementById('titulo-modal-presenca').textContent=r?'Editar presença médica':'Nova presença médica';mostrarEspecial('presenca')}
function editarCondicao(id){const row=listaCondicoes.find(r=>r.id&&Number(r.id)===Number(id));if(row)abrirCondicao(row)}function editarCondicaoPendente(id){const row=listaCondicoes.find(r=>r.pendente_data&&Number(r.funcionario_id)===Number(id));if(row)abrirCondicao(row)}function editarPresenca(id){const row=listaPresencas.find(r=>Number(r.id)===Number(id));if(row)abrirPresenca(row)}
document.getElementById('condicao-funcionario-busca').addEventListener('input',event=>{document.getElementById('condicao-funcionario').value='';clearTimeout(buscaCondicaoTimer);const termo=event.target.value.trim(),lista=document.getElementById('condicao-sugestoes');if(termo.length<2){lista.classList.add('hidden');return}buscaCondicaoTimer=setTimeout(async()=>{try{const rows=await api('funcionarios?busca='+encodeURIComponent(termo));if(document.getElementById('condicao-funcionario-busca').value.trim()!==termo)return;lista.innerHTML=rows.slice(0,8).map(r=>'<button type="button" data-id="'+Number(r.ID)+'" data-nome="'+escapeHtml(r.Nome)+'" class="w-full text-left px-4 py-3 hover:bg-primary-fixed border-b border-border-subtle"><b class="block">'+escapeHtml(r.Nome)+'</b><small>CPF '+escapeHtml(formatCpf(r.CPF||''))+'</small></button>').join('')||'<p class="px-4 py-3">Nenhum funcionário encontrado.</p>';lista.classList.remove('hidden')}catch(error){toast(error.message,'erro')}},250)});
document.getElementById('condicao-sugestoes').addEventListener('click',event=>{const button=event.target.closest('button[data-id]');if(!button)return;document.getElementById('condicao-funcionario').value=button.dataset.id;document.getElementById('condicao-funcionario-busca').value=button.dataset.nome;document.getElementById('condicao-sugestoes').classList.add('hidden')});
function encerrarCondicao(id){document.getElementById('encerrar-condicao-id').value=id;document.getElementById('encerrar-condicao-data').value='';mostrarEspecial('encerrar-condicao')}
document.getElementById('form-encerrar-condicao').onsubmit=async event=>{event.preventDefault();const id=document.getElementById('encerrar-condicao-id').value,data_fim=document.getElementById('encerrar-condicao-data').value;try{await api('condicoes/'+id+'/encerrar',{method:'POST',body:JSON.stringify({data_fim})});fecharEspecial('encerrar-condicao');toast('Condição encerrada.');await carregarCondicoes()}catch(error){toast(error.message,'erro')}};
async function excluirCondicao(id){if(!await confirmarExclusao('Excluir este lançamento do histórico? Se estiver ativo, a condição será removida do cadastro.'))return;try{await api('condicoes/'+id,{method:'DELETE'});toast('Lançamento corrigido.');await carregarCondicoes()}catch(error){toast(error.message,'erro')}}
async function excluirPresenca(id){if(!await confirmarExclusao('Excluir esta presença médica?'))return;try{await api('presencas-medicas/'+id,{method:'DELETE'});toast('Presença excluída.');await carregarPresencas()}catch(error){toast(error.message,'erro')}}
document.getElementById('form-condicao-registro').onsubmit=async event=>{event.preventDefault();const id=document.getElementById('condicao-registro-id').value;if(!document.getElementById('condicao-funcionario').value){toast('Selecione um funcionário pela busca.','erro');return}const body={funcionario_id:document.getElementById('condicao-funcionario').value,condicao:document.getElementById('condicao-tipo').value,data_inicio:document.getElementById('condicao-inicio').value,data_fim:document.getElementById('condicao-fim').value,observacao:document.getElementById('condicao-observacao').value};try{await api('condicoes'+(id?'/'+id:''),{method:id?'PUT':'POST',body:JSON.stringify(body)});fecharEspecial('condicao');toast('Condição salva.');await carregarCondicoes()}catch(error){toast(error.message,'erro')}};
document.getElementById('form-presenca-registro').onsubmit=async event=>{event.preventDefault();const id=document.getElementById('presenca-registro-id').value;const body={data_presenca:document.getElementById('presenca-data').value,observacao:document.getElementById('presenca-observacao').value};try{await api('presencas-medicas'+(id?'/'+id:''),{method:id?'PUT':'POST',body:JSON.stringify(body)});fecharEspecial('presenca');toast('Presença salva.');await carregarPresencas()}catch(error){toast(error.message,'erro')}};
</script>
