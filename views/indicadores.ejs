<% const pageTitle = 'Indicadores'; %>
<%- include('partials/head', {pageTitle}) %>
<%- include('partials/nav', {pageTitle, active: 'indicadores'}) %>
<style>
  @media (min-width: 1024px){.indicadores-content{display:block}.indicadores-content>div:first-child{margin-bottom:14px}.indicadores-grid{height:285px;display:grid;grid-template-columns:1.45fr 1fr;gap:14px;margin-bottom:14px}.indicadores-panel{overflow:hidden}.indicadores-bars{height:195px}.indicadores-table-scroll thead tr{height:44px}.indicadores-table-scroll tbody tr{height:58px}}
  .indicadores-bars{display:flex;align-items:flex-end;gap:10px;margin:8px 12px 12px;padding:16px 12px 34px;border:1px solid #e8edf3;border-radius:8px;background:linear-gradient(to top,rgba(232,237,243,.45),transparent 42%);overflow:visible}.indicadores-bar-item{height:calc(100% - 12px);flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px;position:relative}.indicadores-bar{width:min(36px,68%);min-height:5px;background:#1976c9;border-radius:5px 5px 0 0}.indicadores-bar-label{font-size:10px;position:absolute;bottom:-25px;white-space:nowrap;color:#68768b}.indicadores-list{display:grid;gap:9px}.indicadores-track{height:6px;background:#e8edf3;border-radius:8px;overflow:hidden}.indicadores-fill{height:100%;background:#1976c9}.dark .indicadores-track{background:#263344}.dark .indicadores-bars{border-color:#2d3949;background:linear-gradient(to top,rgba(38,51,68,.55),transparent 42%)}
  .indicadores-table-scroll{overflow-x:auto}.indicadores-table-scroll table{min-width:760px}.indicadores-table-footer{min-height:72px;padding:14px 16px 18px;border-top:1px solid var(--border-subtle,#dfe4ec)}.indicadores-pagination{display:flex;align-items:center;gap:6px}.indicadores-page-button{width:38px;height:38px;border:1px solid var(--border-subtle,#dfe4ec);border-radius:10px;display:inline-flex;align-items:center;justify-content:center;background:transparent}.indicadores-page-button.active{background:#075ca8;color:#fff;border-color:#075ca8}.indicadores-page-button:disabled{opacity:.4}
  .indicadores-content .modern-metric{height:100%}
  .indicadores-filter{display:grid;gap:5px;min-width:0}.indicadores-filter>span{font-size:12px;color:#68768b}.indicadores-filter .modern-control{width:100%;min-width:0}.indicadores-periodo{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px;min-width:0}.indicadores-note{font-size:12px;color:#718097;margin:3px 0 12px}.indicadores-two{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}.indicadores-mini-table{width:100%;border-collapse:collapse;font-size:13px}.indicadores-mini-table th{text-align:left;color:#68768b;font-weight:400;padding:8px 8px 10px 0}.indicadores-mini-table td{padding:11px 8px 11px 0;border-top:1px solid var(--border-subtle,#e1e7ef)}.indicadores-pill{display:inline-block;border-radius:999px;padding:4px 9px;font-size:11px;background:#e6f7ed;color:#167943;white-space:nowrap}.indicadores-pill.warn{background:#fff2dc;color:#a45b00}.indicadores-pill.danger{background:#fee9e9;color:#bb3030}.dark .indicadores-pill{background:#173c2b;color:#7ad7a5}.dark .indicadores-pill.warn{background:#47351a;color:#ffc56e}.dark .indicadores-pill.danger{background:#462326;color:#ff8c91}@media(max-width:800px){.indicadores-two{grid-template-columns:1fr}.indicadores-periodo{grid-template-columns:1fr}}
</style>
<div class="indicadores-page">
  <div class="approved-page-header"><div><h3 class="approved-page-title">Analise os resultados da saúde ocupacional</h3><p class="approved-page-subtitle">Visão consolidada dos dados ocupacionais.</p></div></div>
  <div id="tabs-indicadores" class="modern-tabs line-tabs mb-4 overflow-x-auto whitespace-nowrap"><button class="modern-tab active" data-aba="geral">Visão geral</button><button class="modern-tab" data-aba="vencimentos">Vencimentos</button><button class="modern-tab" data-aba="exames">Exames realizados</button><button class="modern-tab" data-aba="funcionarios">Funcionários</button><button class="modern-tab" data-aba="acidentes">Acidentes / CAT</button><button class="modern-tab" data-aba="encaminhamentos">Encaminhamentos</button><button class="modern-tab" data-aba="atestados">Atestados</button></div>
  <div class="grid grid-cols-2 lg:grid-cols-[minmax(120px,.65fr)_minmax(145px,.9fr)_repeat(3,minmax(150px,1fr))] gap-2 mb-4"><label class="indicadores-filter"><span>Ano</span><select id="filtro-ano" class="approved-input"><option value="">Todos os anos</option><% for(let ano=new Date().getFullYear()+1;ano>=2020;ano--){ %><option value="<%= ano %>" <%= ano===new Date().getFullYear()?'selected':'' %>><%= ano %></option><% } %></select></label><label class="indicadores-filter"><span>Mês</span><select id="filtro-mes" class="approved-input"><option value="">Todos os meses</option><% ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'].forEach((mes,indice)=>{ %><option value="<%= indice+1 %>"><%= mes %></option><% }) %></select></label><label class="indicadores-filter"><span>Empresa</span><select id="filtro-empresa" class="approved-input"><option value="">Todas as empresas</option></select></label><label class="indicadores-filter"><span>Setor</span><select id="filtro-setor" class="approved-input"><option value="">Todos os setores</option></select></label><label class="indicadores-filter"><span>Situação</span><select id="filtro-situacao" class="approved-input"><option value="">Todas as situações</option><option value="ATIVO">Ativos</option><option value="DESLIGADO">Desligados</option></select></label></div>
  <div id="conteudo-indicadores" class="indicadores-content"></div>
</div>
<script>
let dadosIndicadores={},abaIndicador='geral',paginaIndicador=1;
const card=(label,value,note)=>`<div class="modern-surface modern-metric card-animate card-enter"><div class="flex justify-between"><span class="modern-subtitle">${escapeHtml(label)}</span></div><p class="text-[28px] leading-8 font-medium mt-2">${escapeHtml(String(value??0))}</p><small class="modern-subtitle">${escapeHtml(note)}</small></div>`;
function bars(items){const max=Math.max(1,...items.map(x=>Number(x.total)));return `<div class="indicadores-bars">${items.slice(-8).map(x=>`<div class="indicadores-bar-item"><small>${x.total}</small><div class="indicadores-bar" style="height:${Math.max(5,Number(x.total)/max*100)}%"></div><span class="indicadores-bar-label">${String(x.mes||x.nome).replace(/^\d{4}-/,'')}</span></div>`).join('')}</div>`}
function lista(items){const max=Math.max(1,...items.map(x=>Number(x.total)));return `<div class="indicadores-list">${items.slice(0,7).map(x=>`<div><div class="flex justify-between gap-3 text-xs mb-1"><span class="truncate">${x.nome}</span><b>${x.total}</b></div><div class="indicadores-track"><div class="indicadores-fill" style="width:${Number(x.total)/max*100}%"></div></div></div>`).join('')||'<p class="modern-subtitle">Sem registros neste período.</p>'}</div>`}
function tabela(rows){const todos=rows||[],totalPaginas=Math.max(1,Math.ceil(todos.length/5));paginaIndicador=Math.min(Math.max(1,paginaIndicador),totalPaginas);const inicio=(paginaIndicador-1)*5,visiveis=todos.slice(inicio,inicio+5);const paginas=[];for(let p=1;p<=totalPaginas;p++){if(totalPaginas<=5||p===1||p===totalPaginas||Math.abs(p-paginaIndicador)<=1)paginas.push(`<button class="indicadores-page-button ${p===paginaIndicador?'active':''}" onclick="mudarPaginaIndicador(${p})">${p}</button>`);else if(paginas[paginas.length-1]!=='<span class="px-1">…</span>')paginas.push('<span class="px-1">…</span>')}return `<div class="indicadores-table-scroll"><table class="modern-table w-full text-left border-collapse"><thead class="bg-background-main border-b border-border-subtle"><tr><th class="px-4 py-3">Data</th><th class="px-4 py-3">Funcionário</th><th class="px-4 py-3">Empresa / setor</th><th class="px-4 py-3">Detalhe</th><th class="px-4 py-3">Situação</th></tr></thead><tbody class="divide-y divide-border-subtle">${visiveis.map(x=>`<tr><td class="px-4 py-3 whitespace-nowrap">${x.data||x.vencimento||'—'}</td><td class="px-4 py-3"><b>${x.nome||''}</b><small class="block modern-subtitle">${x.cpf||''}</small></td><td class="px-4 py-3">${x.empresa||''}<small class="block modern-subtitle">${x.setor||''}</small></td><td class="px-4 py-3">${x.detalhe||x.ultimo_exame||'—'}</td><td class="px-4 py-3">${pill(x.situacao||x.origem||'Registrado')}</td></tr>`).join('')||'<tr><td colspan="5" class="px-4 py-4 modern-subtitle">Sem registros para este recorte.</td></tr>'}</tbody></table></div><div class="indicadores-table-footer flex flex-wrap items-center justify-between gap-3"><span class="modern-subtitle">Mostrando ${todos.length?inicio+1:0}–${Math.min(inicio+5,todos.length)} de ${todos.length}</span><div class="indicadores-pagination"><button class="indicadores-page-button" onclick="mudarPaginaIndicador(${paginaIndicador-1})" ${paginaIndicador===1?'disabled':''} aria-label="Página anterior">‹</button>${paginas.join('')}<button class="indicadores-page-button" onclick="mudarPaginaIndicador(${paginaIndicador+1})" ${paginaIndicador===totalPaginas?'disabled':''} aria-label="Próxima página">›</button></div></div>`}
function mudarPaginaIndicador(pagina){paginaIndicador=pagina;renderIndicadores()}
const pill=value=>{const v=String(value||'').toUpperCase(),kind=v.includes('ATRAS')||v.includes('PEND')?'danger':v.includes('EM ')||v.includes('SEM PDF')?'warn':'';return `<span class="indicadores-pill ${kind}">${value||'—'}</span>`};
function painel(titulo,nota,conteudo){return `<section class="modern-surface p-4 indicadores-panel"><h3 class="font-semibold">${titulo}</h3>${nota?`<p class="indicadores-note">${nota}</p>`:''}${conteudo}</section>`}
function miniTabela(headers,rows){return `<table class="indicadores-mini-table"><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table>`}
function tabelaDetalhada(rows,title){return `<section class="modern-surface indicadores-panel"><div class="px-4 py-3 border-b border-border-subtle"><h3 class="font-semibold">${title}</h3></div>${tabela(rows)}</section>`}
function renderIndicadores(){
  const d=dadosIndicadores,r=d.resumo||{};let cards='',middle='',bottom='';
  if(abaIndicador==='geral'){
    const totalExames=(d.tiposExame||[]).reduce((a,x)=>a+Number(x.total),0),totalCats=(d.acidentesMes||[]).reduce((a,x)=>a+Number(x.total),0),totalEnc=(d.encaminhamentosMes||[]).reduce((a,x)=>a+Number(x.total),0);
    cards=card('Funcionários cadastrados',r.total,'cadastros atuais')+card('Exames atrasados',r.atrasados,'somente ativos elegíveis')+card('Exames realizados',totalExames,'histórico + sistema')+card('Acidentes / CAT',totalCats,'registros do período');
    middle=`<div class="indicadores-grid">${painel('Exames realizados por mês','Histórico completo após a importação',bars(d.examesMes||[]))}${painel('Visão dos funcionários','Situação e condições atuais',lista([{nome:'Ativos',total:r.ativos||0},{nome:'Afastados',total:r.afastados||0},{nome:'Desligados',total:r.desligados||0},{nome:'Com condição',total:(d.condicoes||[]).filter(x=>x.nome!=='SEM CONDIÇÃO').reduce((a,x)=>a+Number(x.total),0)}]))}</div>`;
    bottom=`<div class="indicadores-two">${painel('Vencimentos prioritários','',miniTabela(['Faixa','Total','Situação'],[`<tr><td>Atrasados</td><td>${r.atrasados||0}</td><td>${pill('Regularizar')}</td></tr>`,`<tr><td>Até 30 dias</td><td>${r.vencer30||0}</td><td>${pill('Planejar')}</td></tr>`,`<tr><td>31–60 dias</td><td>${r.vencer60||0}</td><td>${pill('Planejar')}</td></tr>`]))}${painel('Outros acompanhamentos','',miniTabela(['Indicador','Total','Situação'],[`<tr><td>Encaminhamentos</td><td>${totalEnc}</td><td>${pill('Acompanhar')}</td></tr>`,`<tr><td>CAT registradas</td><td>${totalCats}</td><td>${pill('Acompanhar')}</td></tr>`,`<tr><td>Condições cadastradas</td><td>${(d.condicoes||[]).length}</td><td>${pill('Atualizado')}</td></tr>`]))}</div>`;
  }
  if(abaIndicador==='vencimentos'){
    cards=card('Atrasados',r.atrasados,'exigem regularização')+card('Até 30 dias',r.vencer30,'próximos vencimentos')+card('31 a 60 dias',r.vencer60,'planejamento antecipado')+card('Acima de 60 dias',Math.max(0,(r.ativos||0)-(r.atrasados||0)-(r.vencer30||0)-(r.vencer60||0)),'no prazo');
    middle=`<div class="indicadores-grid">${painel('Distribuição dos vencimentos','Ativos sem condição que suspenda a cobrança',bars([{nome:'Atrasados',total:r.atrasados},{nome:'Até 30d',total:r.vencer30},{nome:'31–60d',total:r.vencer60},{nome:'+60d',total:Math.max(0,(r.ativos||0)-(r.atrasados||0)-(r.vencer30||0)-(r.vencer60||0))}]))}${painel('Condições excluídas do atraso','Aparecem separadamente para acompanhamento',lista((d.condicoes||[]).filter(x=>x.nome!=='SEM CONDIÇÃO')))}</div>`;
    bottom=tabelaDetalhada(d.atencao,'Funcionários que exigem atenção');
  }
  if(abaIndicador==='exames'){
    const total=(d.tiposExame||[]).reduce((a,x)=>a+Number(x.total),0),com=(d.examesRecentes||[]).filter(x=>x.historico_aso_id).length;
    cards=card('Eventos registrados',total,'planilha + novos registros')+card('Tipos de exame',(d.tiposExame||[]).length,'categorias')+card('Com documento',com,'ASOs vinculados na amostra')+card('Sem documento',Math.max(0,(d.examesRecentes||[]).length-com),'importado/manual na amostra');
    middle=`<div class="indicadores-grid">${painel('Exames por mês','Distribuição do período selecionado',bars(d.examesMes||[]))}${painel('Exames por tipo','Documento e evento permanecem vinculados',lista(d.tiposExame||[]))}</div>`;
    bottom=tabelaDetalhada(d.examesRecentes,'Últimos exames realizados');
  }
  if(abaIndicador==='funcionarios'){
    cards=card('Total cadastrado',r.total,'todas as situações')+card('Ativos',r.ativos,'quadro atual')+card('Afastados',r.afastados,'acompanhamento')+card('Com condição',(d.condicoes||[]).filter(x=>x.nome!=='SEM CONDIÇÃO').reduce((a,x)=>a+Number(x.total),0),'gestante e outras');
    middle=`<div class="indicadores-grid">${painel('Ativos por empresa','Distribuição atual',lista(d.empresas||[]))}${painel('Principais cargos','Funcionários ativos',lista(d.cargos||[]))}</div>`;
    bottom=`<div class="indicadores-two">${painel('Setores com maior quadro','',miniTabela(['Setor','Ativos'],(d.setores||[]).slice(0,5).map(x=>`<tr><td>${x.nome}</td><td>${x.total}</td></tr>`)))}${painel('Condições cadastradas','',miniTabela(['Condição','Total','Impacto no atraso'],(d.condicoes||[]).filter(x=>x.nome!=='SEM CONDIÇÃO').slice(0,5).map(x=>`<tr><td>${x.nome}</td><td>${x.total}</td><td>${pill('Não contabiliza')}</td></tr>`)))}</div>`;
  }
  if(abaIndicador==='acidentes'){
    const total=(d.acidentesMes||[]).reduce((a,x)=>a+Number(x.total),0),emitidas=(d.acidentesRecentes||[]).filter(x=>x.situacao==='SIM').length;
    cards=card('Acidentes registrados',total,'no período selecionado')+card('CAT emitidas',emitidas,'na amostra recente')+card('Agentes',(d.agentes||[]).length,'categorias')+card('Acompanhamentos',(d.acidentesRecentes||[]).length,'registros recentes');
    middle=`<div class="indicadores-grid">${painel('Acidentes por mês','Evolução do período',bars(d.acidentesMes||[]))}${painel('Agente causador','Concentração dos registros',lista(d.agentes||[]))}</div>`;
    bottom=tabelaDetalhada(d.acidentesRecentes,'Registros recentes');
  }
  if(abaIndicador==='encaminhamentos'){
    const total=(d.encaminhamentosMes||[]).reduce((a,x)=>a+Number(x.total),0),pendentes=(d.encaminhamentosRecentes||[]).filter(x=>String(x.situacao).toUpperCase()==='PENDENTE').length;
    cards=card('Encaminhamentos',total,'no período selecionado')+card('Especialidades',(d.especialidades||[]).length,'destinos')+card('Pendentes',pendentes,'na amostra recente')+card('Concluídos',Math.max(0,(d.encaminhamentosRecentes||[]).length-pendentes),'na amostra recente');
    middle=`<div class="indicadores-grid">${painel('Encaminhamentos por mês','Evolução dos registros',bars(d.encaminhamentosMes||[]))}${painel('Destino / especialidade','Distribuição atual',lista(d.especialidades||[]))}</div>`;
    bottom=tabelaDetalhada(d.encaminhamentosRecentes,'Encaminhamentos recentes');
  }
  if(abaIndicador==='atestados'){
    const a=d.resumoAtestados||{};
    cards=card('Atestados',a.total,'no período')+card('Dias afastados',Number(a.dias||0).toFixed(1).replace('.',','),'total acumulado')+card('Média',Number(a.media||0).toFixed(1).replace('.',','),'dias por atestado')+card('INSS',a.inss,'afastamentos');
    middle=`<div class="indicadores-grid">${painel('Atestados por mês','Quantidade de registros no período',bars(d.atestadosMes||[]))}${painel('Principais CIDs','Participação no período',lista(d.cidsAtestados||[]))}</div>`;
    bottom=tabelaDetalhada(d.atestadosRecentes,'Atestados recentes');
  }
  document.getElementById('conteudo-indicadores').innerHTML=`<div class="grid grid-cols-2 xl:grid-cols-4 gap-2 mb-[14px]">${cards}</div>${middle}${bottom}`;
}
async function carregarIndicadores(){try{const q=new URLSearchParams();const empresa=document.getElementById('filtro-empresa').value,setor=document.getElementById('filtro-setor').value,situacao=document.getElementById('filtro-situacao').value,ano=Number(document.getElementById('filtro-ano').value),mes=Number(document.getElementById('filtro-mes').value);if(mes&&!ano){toast('Selecione um ano para filtrar por mês.','erro');return}if(empresa)q.set('empresa',empresa);if(setor)q.set('setor',setor);if(situacao)q.set('situacao',situacao);if(ano){q.set('inicio',mes?`${ano}-${String(mes).padStart(2,'0')}-01`:`${ano}-01-01`);q.set('fim',mes?`${ano}-${String(mes).padStart(2,'0')}-${new Date(ano,mes,0).getDate()}`:`${ano}-12-31`)}paginaIndicador=1;dadosIndicadores=await api(`indicadores?${q}`);renderIndicadores()}catch(err){toast(err.message,'erro')}}
document.querySelectorAll('#tabs-indicadores button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#tabs-indicadores button').forEach(x=>x.classList.remove('active'));b.classList.add('active');abaIndicador=b.dataset.aba;paginaIndicador=1;renderIndicadores()});
const abaSolicitada=new URLSearchParams(window.location.search).get('aba');
if(abaSolicitada){const botao=document.querySelector(`#tabs-indicadores button[data-aba="${CSS.escape(abaSolicitada)}"]`);if(botao){document.querySelectorAll('#tabs-indicadores button').forEach(x=>x.classList.remove('active'));botao.classList.add('active');abaIndicador=abaSolicitada}}
Promise.all([api('empresas'),api('setores')]).then(([empresas,setores])=>{document.getElementById('filtro-empresa').innerHTML+=[...empresas].map(x=>`<option value="${x.ID}">${x.RazaoSocial}</option>`).join('');document.getElementById('filtro-setor').innerHTML+=[...setores].map(x=>`<option value="${x.ID}">${x.Nome}</option>`).join('')});['filtro-empresa','filtro-setor','filtro-situacao','filtro-ano','filtro-mes'].forEach(id=>document.getElementById(id).onchange=carregarIndicadores);carregarIndicadores();
</script>
<%- include('partials/foot') %>
