<% const pageTitle = 'Configurações'; %>
<%- include('partials/head', {pageTitle}) %>
<%- include('partials/nav', {pageTitle, active: 'configuracoes'}) %>

<div class="approved-page-header">
  <div><h3 class="approved-page-title">Ajuste as preferências do sistema</h3><p class="approved-page-subtitle">Empresas, documentos, backups e preferências do sistema.</p></div>
  <button id="salvar-config-topo" type="submit" form="form-config" class="approved-button primary hidden"><span data-ui-icon="save"></span>Salvar configurações</button>
</div>
<div class="config-page-layout">
  <aside class="config-page-nav" aria-label="Seções das configurações">
    <button type="button" onclick="mostrarAbaConfig('empresas')" data-aba="empresas" class="aba-config active">Empresas e logos</button>
    <button type="button" onclick="mostrarAbaConfig('medico')" data-aba="medico" class="aba-config">Médico</button>
    <button type="button" onclick="mostrarAbaConfig('aparencia')" data-aba="aparencia" class="aba-config">Aparência</button>
    <button type="button" onclick="mostrarAbaConfig('backup')" data-aba="backup" class="aba-config">Backup</button>
  </aside>
  <div class="config-page-main">

<section id="painel-empresas" class="painel-config config-company-grid">
  <div class="approved-data-card p-5"><div class="mb-3"><h4 class="font-semibold">Empresas cadastradas</h4><p class="approved-page-subtitle">O logo personalizado será aplicado aos documentos da empresa.</p></div><div class="overflow-x-auto"><table class="w-full text-left"><thead><tr><th>Razão social</th><th>CNPJ</th><th class="text-right">Ações</th></tr></thead><tbody id="tbody-empresas" class="font-table-data text-table-data"></tbody></table></div><button onclick="abrirModalEmpresa()" class="approved-button mt-4"><span data-ui-icon="plus"></span>Nova empresa</button></div>
  <aside class="approved-data-card p-5"><h4 class="font-semibold">Identidade da empresa</h4><p id="empresa-selecionada-resumo" class="approved-page-subtitle mb-4">Selecione uma empresa cadastrada.</p><form id="form-identidade-empresa" class="space-y-3"><div><label for="identidade-razao" class="block text-sm mb-1">Razão social</label><input id="identidade-razao" class="approved-input" required disabled></div><div><label for="identidade-cnpj" class="block text-sm mb-1">CNPJ</label><input id="identidade-cnpj" class="approved-input" required disabled></div><div><label for="identidade-logo" class="block text-sm mb-1">Logo opcional</label><img id="identidade-logo-preview" alt="Logo atual da empresa" class="hidden max-w-full h-20 object-contain mb-2"><input id="identidade-logo" type="file" accept="image/png,image/jpeg" class="approved-input pt-2" disabled></div><p class="rounded-xl bg-blue-50 p-3 text-xs text-primary">Sem logo enviado, o sistema mantém automaticamente o logo atual da empresa.</p><button id="identidade-salvar" class="approved-button primary w-full" disabled>Salvar empresa</button></form></aside>
</section>

<form id="form-config" class="max-w-5xl">
  <section id="painel-medico" class="painel-config hidden bg-surface border border-border-subtle rounded-xl p-6 space-y-6">
    <div class="flex items-center gap-3 border-b border-border-subtle pb-4"><span id="preview-icone-medico" class="w-10 h-10 rounded-full bg-primary-fixed text-primary flex items-center justify-center"><span class="material-symbols-outlined">medical_services</span></span><div><h4 class="font-headline-md">Médico coordenador</h4><p class="text-body-md text-on-surface-variant">Esses dados aparecem no cabeçalho da aplicação e no ASO.</p></div></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="md:col-span-2"><label class="block text-body-md font-semibold mb-1">Médico</label><input id="Medico" required class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-1">CRM</label><input id="CRM" class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-1">Especialidade</label><input id="Especialidade" class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-1">RQE</label><input id="RQE" class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-2">Ícone do médico</label><input id="IconeMedico" type="hidden" value="medical_services"><div id="opcoes-icone-medico" class="flex flex-wrap gap-2"><button type="button" data-icone="medical_services" onclick="selecionarIconeMedico('medical_services')" title="Serviços médicos" class="opcao-icone-medico"><span class="material-symbols-outlined">medical_services</span></button><button type="button" data-icone="stethoscope" onclick="selecionarIconeMedico('stethoscope')" title="Estetoscópio" class="opcao-icone-medico"><span class="material-symbols-outlined">stethoscope</span></button><button type="button" data-icone="health_and_safety" onclick="selecionarIconeMedico('health_and_safety')" title="Saúde e segurança" class="opcao-icone-medico"><span class="material-symbols-outlined">health_and_safety</span></button><button type="button" data-icone="clinical_notes" onclick="selecionarIconeMedico('clinical_notes')" title="Prontuário clínico" class="opcao-icone-medico"><span class="material-symbols-outlined">clinical_notes</span></button><button type="button" data-icone="cardiology" onclick="selecionarIconeMedico('cardiology')" title="Cardiologia" class="opcao-icone-medico"><span class="material-symbols-outlined">cardiology</span></button></div></div>
    </div>
    <div class="flex justify-end"><button type="submit" class="approved-button primary">Salvar configurações</button></div>
  </section>
</form>

<section id="painel-backup" class="painel-config hidden max-w-5xl space-y-5">
  <div class="bg-surface border border-border-subtle rounded-xl p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div><h4 class="font-headline-md">Backup automático</h4><p class="text-body-md text-on-surface-variant mt-1">Salva automaticamente todos os dados e arquivos institucionais na pasta configurada no servidor.</p></div>
      <div class="flex flex-wrap gap-3"><button type="button" onclick="baixarSchemaBanco()" class="border border-primary text-primary px-5 py-2.5 rounded-lg font-bold inline-flex items-center gap-2"><span class="material-symbols-outlined">database</span>Baixar schema SQL</button><button id="btn-criar-backup" type="button" onclick="criarBackupCompleto()" class="bg-primary text-white px-5 py-2.5 rounded-lg font-bold inline-flex items-center gap-2"><span class="material-symbols-outlined">download</span>Baixar backup agora</button></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-5">
      <div class="bg-background-main border border-border-subtle rounded-lg p-4"><p class="text-label-caps uppercase text-on-surface-variant">Pasta no servidor</p><p id="backup-diretorio" class="font-semibold mt-2 break-all">Carregando...</p></div>
      <div class="bg-background-main border border-border-subtle rounded-lg p-4"><p class="text-label-caps uppercase text-on-surface-variant">Último automático</p><p id="backup-ultimo" class="font-semibold mt-2">Carregando...</p></div>
      <div class="bg-background-main border border-border-subtle rounded-lg p-4"><p class="text-label-caps uppercase text-on-surface-variant">Próximo automático</p><p id="backup-proximo" class="font-semibold mt-2">–</p></div>
    </div>
    <form id="form-backup-config" class="flex flex-wrap items-end gap-3 mt-5">
      <div><label for="backup-intervalo" class="block text-body-md font-semibold mb-1">Criar a cada</label><div class="flex items-center gap-2"><input id="backup-intervalo" type="number" min="1" max="365" required class="campo w-28"><span class="text-body-md text-on-surface-variant">dias</span></div></div>
      <div><label for="backup-retencao" class="block text-body-md font-semibold mb-1">Manter por</label><div class="flex items-center gap-2"><input id="backup-retencao" type="number" min="1" max="3650" required class="campo w-28"><span class="text-body-md text-on-surface-variant">dias</span></div></div>
      <button class="px-4 py-2.5 border border-primary text-primary rounded-lg font-bold hover:bg-primary-fixed">Salvar automação</button>
    </form>
    <p id="backup-pasta-status" class="text-body-md text-on-surface-variant mt-3"></p>
  </div>

  <div class="bg-surface border border-border-subtle rounded-xl p-6">
    <div class="flex items-start gap-3"><span class="material-symbols-outlined text-error">restore</span><div><h4 class="font-headline-md">Restaurar backup</h4><p class="text-body-md text-on-surface-variant mt-1">A restauração substitui integralmente os dados atuais. O arquivo será validado antes de liberar a confirmação.</p></div></div>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <input id="arquivo-backup" type="file" accept=".medbackup,application/octet-stream" class="block flex-1 min-w-[18rem] text-body-md file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:bg-primary-fixed file:text-primary file:font-bold">
      <button id="btn-validar-backup" type="button" onclick="validarArquivoBackup()" class="px-5 py-2.5 border border-primary text-primary rounded-lg font-bold">Validar arquivo</button>
    </div>
    <div id="backup-validacao" class="hidden mt-5 border border-border-subtle rounded-lg p-4 bg-background-main">
      <p class="font-bold text-primary flex items-center gap-2"><span class="material-symbols-outlined">verified</span>Backup válido</p>
      <div id="backup-validacao-resumo" class="text-body-md text-on-surface-variant mt-2"></div>
      <div class="flex justify-end mt-4"><button id="btn-restaurar-backup" type="button" onclick="restaurarBackupValidado()" class="bg-error text-white px-5 py-2.5 rounded-lg font-bold inline-flex items-center gap-2"><span class="material-symbols-outlined">restore</span>Restaurar dados</button></div>
    </div>
  </div>
</section>

<section id="painel-aparencia" class="painel-config hidden">
  <div class="config-section-heading"><h4>Aparência</h4><p>Preferências visuais deste navegador. As alterações são pré-visualizadas imediatamente e aplicadas a todas as telas após salvar.</p></div>
  <div class="config-appearance-grid">
    <div class="config-appearance-card"><h5>Sidebar</h5><p>Larguras do menu nos estados amplo, compacto e recolhido.</p>
      <div class="config-setting"><label for="mo-sidebar-wide">Desktop amplo</label><input id="mo-sidebar-wide" type="number" min="190" max="260" data-mo-setting="sidebarWide"><span>px</span><input type="range" min="190" max="260" data-mo-setting="sidebarWide" aria-label="Largura do menu amplo"></div>
      <div class="config-setting"><label for="mo-sidebar-compact">Desktop compacto</label><input id="mo-sidebar-compact" type="number" min="160" max="220" data-mo-setting="sidebarCompact"><span>px</span><input type="range" min="160" max="220" data-mo-setting="sidebarCompact" aria-label="Largura do menu compacto"></div>
      <div class="config-setting"><label for="mo-sidebar-collapsed">Recolhida</label><input id="mo-sidebar-collapsed" type="number" min="60" max="100" data-mo-setting="sidebarCollapsed"><span>px</span><input type="range" min="60" max="100" data-mo-setting="sidebarCollapsed" aria-label="Largura do menu recolhido"></div>
      <button id="mo-test-collapse" type="button" class="approved-button mt-4">Testar recolhimento</button>
    </div>
    <div class="config-appearance-card"><h5>Tipografia de página</h5><p>Tamanhos de título e subtítulo da área de conteúdo.</p>
      <div class="config-setting"><label for="mo-page-title">Título</label><input id="mo-page-title" type="number" min="22" max="38" data-mo-setting="pageTitle"><span>px</span><input type="range" min="22" max="38" data-mo-setting="pageTitle" aria-label="Tamanho do título"></div>
      <div class="config-setting"><label for="mo-page-subtitle">Subtítulo</label><input id="mo-page-subtitle" type="number" min="11" max="18" data-mo-setting="pageSubtitle"><span>px</span><input type="range" min="11" max="18" data-mo-setting="pageSubtitle" aria-label="Tamanho do subtítulo"></div>
    </div>
    <div class="config-appearance-card wide"><h5>Carregamento global e spinner</h5><p>Cores, espessura e velocidades do carregamento inicial e entre páginas.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="config-setting"><label for="mo-track">Trilho</label><input id="mo-track" type="color" data-mo-setting="track"><span></span></div>
        <div class="config-setting"><label for="mo-drop">Gota</label><input id="mo-drop" type="color" data-mo-setting="drop"><span></span></div>
        <div class="config-setting"><label for="mo-glow">Brilho</label><input id="mo-glow" type="color" data-mo-setting="glow"><span></span></div>
        <div class="config-setting"><label for="mo-spin-1">Spinner 1</label><input id="mo-spin-1" type="color" data-mo-setting="spin1"><span></span></div>
        <div class="config-setting"><label for="mo-spin-2">Spinner 2</label><input id="mo-spin-2" type="color" data-mo-setting="spin2"><span></span></div>
        <div class="config-setting"><label for="mo-spin-3">Spinner 3</label><input id="mo-spin-3" type="color" data-mo-setting="spin3"><span></span></div>
        <div class="config-setting"><label for="mo-spin-4">Spinner 4</label><input id="mo-spin-4" type="color" data-mo-setting="spin4"><span></span></div>
      </div>
      <div class="config-setting"><label for="mo-spinner-seconds">Velocidade do spinner</label><input id="mo-spinner-seconds" type="number" min="0.6" max="4" step="0.01" data-mo-setting="spinnerSeconds"><span>s</span><input type="range" min="0.6" max="4" step="0.01" data-mo-setting="spinnerSeconds" aria-label="Velocidade do spinner"></div>
      <div class="config-setting"><label for="mo-loading-seconds">Velocidade do loading</label><input id="mo-loading-seconds" type="number" min="0.6" max="4" step="0.01" data-mo-setting="loadingSeconds"><span>s</span><input type="range" min="0.6" max="4" step="0.01" data-mo-setting="loadingSeconds" aria-label="Velocidade do loading"></div>
      <div class="config-setting"><label for="mo-spinner-width">Espessura do spinner</label><input id="mo-spinner-width" type="number" min="1" max="5" step="0.05" data-mo-setting="spinnerWidth"><span>px</span><input type="range" min="1" max="5" step="0.05" data-mo-setting="spinnerWidth" aria-label="Espessura do spinner"></div>
      <div class="config-loading-preview"><svg class="mo-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" class="mo-spinner-arc"/></svg><div class="config-preview-track" aria-hidden="true"><span></span></div><small>Prévia permanente. O botão abaixo executa o loading global real da aplicação.</small></div>
      <div class="flex flex-wrap gap-2"><button id="mo-test-loading" type="button" class="approved-button">Testar carregamento global</button><button id="mo-test-success" type="button" class="approved-button">Testar sucesso</button><button id="mo-test-error" type="button" class="approved-button">Testar erro</button></div>
    </div>
  </div>
  <div class="flex flex-wrap justify-end gap-2 mt-4"><button id="mo-reset-appearance" type="button" class="approved-button">Restaurar padrão</button><button id="mo-save-appearance" type="button" class="approved-button primary">Salvar aparência</button></div>
</section>

  </div>
</div>

<div id="modal-empresa" class="fixed inset-0 z-50 hidden items-center justify-center modal-backdrop"><div class="bg-surface rounded-xl w-full max-w-2xl p-6 max-h-[90vh] overflow-y-auto"><h3 id="modal-empresa-titulo" class="font-headline-md mb-4">Empresa</h3><form id="form-empresa" class="grid grid-cols-1 md:grid-cols-2 gap-4"><input type="hidden" id="empresa-id"><input type="hidden" id="empresa-logo-data"><div class="md:col-span-2"><label class="block font-semibold mb-1">Razão social</label><input id="empresa-razao" required class="campo"></div><div><label class="block font-semibold mb-1">CNPJ</label><input id="empresa-cnpj" required class="campo"></div><div><label class="block font-semibold mb-1">Telefone</label><input id="empresa-telefone" class="campo"></div><div class="md:col-span-2"><label class="block font-semibold mb-1">Endereço</label><input id="empresa-endereco" class="campo"></div><div><label class="block font-semibold mb-1">Bairro</label><input id="empresa-bairro" class="campo"></div><div><label class="block font-semibold mb-1">Cidade/UF</label><input id="empresa-cidade" class="campo"></div><div><label class="block font-semibold mb-1">CEP</label><input id="empresa-cep" class="campo"></div><div class="md:col-span-2"><label class="block font-semibold mb-1">Logo da empresa <span class="font-normal text-on-surface-variant">(opcional)</span></label><div class="flex flex-wrap items-center gap-3"><div id="empresa-logo-preview-box" class="hidden w-48 h-20 border border-border-subtle rounded-lg bg-white p-2 items-center justify-center"><img id="empresa-logo-preview" class="max-w-full max-h-full object-contain" alt="Prévia do logo"></div><div class="flex-1 min-w-56"><input id="empresa-logo-arquivo" type="file" accept="image/png,image/jpeg" class="block w-full text-body-md file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-primary-fixed file:text-primary file:font-bold"><button id="empresa-logo-remover" type="button" onclick="removerLogoEmpresa()" class="hidden mt-2 text-error font-semibold text-body-md">Remover logo personalizado</button><p class="text-body-md text-on-surface-variant mt-1">PNG ou JPG. Sem logo personalizado, será usado o logo atual.</p></div></div></div><div class="md:col-span-2 flex justify-end gap-3"><button type="button" onclick="fecharModalEmpresa()" class="px-4 py-2">Cancelar</button><button class="px-4 py-2 bg-primary text-white rounded-lg font-bold">Salvar</button></div></form></div></div>

<style>.config-company-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.9fr);gap:14px;max-width:1100px}.config-company-grid.hidden{display:none!important}.campo{width:100%;padding:.625rem .75rem;border:1px solid #DEE2E6;border-radius:.5rem}.campo:focus{outline:2px solid #00478d;outline-offset:1px}.opcao-icone-medico{width:42px;height:42px;border:1px solid #DEE2E6;border-radius:.5rem;color:#424752}.opcao-icone-medico:hover,.opcao-icone-medico.ativo{background:#dce8f8;border-color:#00478d;color:#00478d}@media(max-width:800px){.config-company-grid{grid-template-columns:1fr}}</style>
<script>
const CONFIG_FIELDS=['Medico','CRM','Especialidade','RQE','IconeMedico'];
let tokenBackupValidado='';
let empresaIdentidadeSelecionada=null;
function selecionarEmpresaIdentidade(r){empresaIdentidadeSelecionada=r;document.getElementById('empresa-selecionada-resumo').textContent=r.RazaoSocial;document.getElementById('identidade-razao').value=r.RazaoSocial||'';document.getElementById('identidade-cnpj').value=r.CNPJ||'';document.getElementById('identidade-logo').value='';const imagem=document.getElementById('identidade-logo-preview');imagem.classList.toggle('hidden',!r.LogoData);if(r.LogoData)imagem.src=r.LogoData;else imagem.removeAttribute('src');['identidade-razao','identidade-cnpj','identidade-logo','identidade-salvar'].forEach(id=>document.getElementById(id).disabled=false)}
document.getElementById('form-identidade-empresa').addEventListener('submit',async event=>{event.preventDefault();const r=empresaIdentidadeSelecionada;if(!r)return;const arquivo=document.getElementById('identidade-logo').files[0];if(arquivo&&(!['image/png','image/jpeg'].includes(arquivo.type)||arquivo.size>2*1024*1024))return toast('Use PNG ou JPG de até 2 MB.','erro');let logo=r.LogoData||'';if(arquivo)logo=await new Promise((resolve,reject)=>{const leitor=new FileReader();leitor.onload=()=>resolve(leitor.result);leitor.onerror=reject;leitor.readAsDataURL(arquivo)});const payload={RazaoSocial:document.getElementById('identidade-razao').value.trim(),CNPJ:document.getElementById('identidade-cnpj').value.trim(),Telefone:r.Telefone||'',Endereco:r.Endereco||'',Bairro:r.Bairro||'',CidadeUf:r.CidadeUf||'',Cep:r.Cep||'',LogoData:logo};try{await api(`empresas/${r.ID}`,{method:'PUT',body:JSON.stringify(payload)});toast('Identidade da empresa salva.');await carregarEmpresas()}catch(error){toast(error.message,'erro')}});
function mostrarAbaConfig(aba){document.querySelectorAll('.painel-config').forEach(p=>p.classList.toggle('hidden',p.id!==`painel-${aba}`));document.querySelectorAll('.aba-config').forEach(b=>b.className=`aba-config${b.dataset.aba===aba?' active':''}`);document.getElementById('salvar-config-topo').classList.toggle('hidden',aba!=='medico')}
function atualizarPreviewIcone(){const icone=document.getElementById('IconeMedico').value;document.querySelector('#preview-icone-medico .material-symbols-outlined').textContent=icone;document.querySelectorAll('.opcao-icone-medico').forEach(botao=>botao.classList.toggle('ativo',botao.dataset.icone===icone))}function selecionarIconeMedico(icone){document.getElementById('IconeMedico').value=icone;atualizarPreviewIcone()}
async function carregarConfig(){const cfg=await api('config');CONFIG_FIELDS.forEach(f=>{const el=document.getElementById(f);if(el)el.value=cfg[f]||''});atualizarPreviewIcone()}
document.getElementById('form-config').addEventListener('submit',async e=>{e.preventDefault();const payload={};CONFIG_FIELDS.forEach(f=>payload[f]=document.getElementById(f).value.trim());try{const config=await api('config',{method:'PUT',body:JSON.stringify(payload)});const medico=document.getElementById('nav-medico');const especialidade=document.getElementById('nav-especialidade');const avatar=document.getElementById('nav-avatar-iniciais');if(medico)medico.textContent=config.Medico||'Médico coordenador';if(especialidade)especialidade.textContent=config.Especialidade||'Medicina do Trabalho';if(avatar)avatar.textContent=(config.Medico||'Médico coordenador').replace(/^Dr\.?\s*/i,'').trim().split(/\s+/).slice(0,2).map(parte=>parte[0]).join('').toUpperCase()||'MC';toast('Configurações salvas.')}catch(err){toast(err.message,'erro')}});
async function carregarEmpresas(){
  const rows=await api('empresas');
  document.getElementById('tbody-empresas').innerHTML=rows.map(r=>`<tr><td class="font-medium"><span>${escapeHtml(r.RazaoSocial)}<small class="block modern-subtitle">${escapeHtml(r.CidadeUf||'')}</small></span></td><td>${escapeHtml(r.CNPJ)}</td><td class="text-right whitespace-nowrap"><button onclick='selecionarEmpresaIdentidade(${JSON.stringify(r).replace(/'/g,"&#39;")})' class="approved-action" title="Identidade" aria-label="Editar identidade da empresa"><span class="material-symbols-outlined">edit</span></button><button onclick='abrirModalEmpresa(${JSON.stringify(r).replace(/'/g,"&#39;")})' class="approved-action" title="Cadastro completo" aria-label="Editar cadastro completo"><span class="material-symbols-outlined">settings</span></button><button onclick="excluirEmpresa(${r.ID})" class="approved-action danger" title="Excluir" aria-label="Excluir empresa"><span class="material-symbols-outlined">delete</span></button></td></tr>`).join('')||'<tr><td colspan="3" class="py-3 text-on-surface-variant">Nenhuma empresa cadastrada.</td></tr>';
  if(empresaIdentidadeSelecionada){const atual=rows.find(row=>row.ID===empresaIdentidadeSelecionada.ID);if(atual)selecionarEmpresaIdentidade(atual);else{empresaIdentidadeSelecionada=null;document.getElementById('form-identidade-empresa').reset();document.getElementById('empresa-selecionada-resumo').textContent='Selecione uma empresa cadastrada.';['identidade-razao','identidade-cnpj','identidade-logo','identidade-salvar'].forEach(id=>document.getElementById(id).disabled=true)}}
}
function atualizarPreviewLogoEmpresa(valor=''){const data=document.getElementById('empresa-logo-data'),box=document.getElementById('empresa-logo-preview-box'),img=document.getElementById('empresa-logo-preview'),remover=document.getElementById('empresa-logo-remover');data.value=valor||'';if(data.value){img.src=data.value;box.classList.remove('hidden');box.classList.add('flex');remover.classList.remove('hidden')}else{img.removeAttribute('src');box.classList.add('hidden');box.classList.remove('flex');remover.classList.add('hidden')}}
function removerLogoEmpresa(){document.getElementById('empresa-logo-arquivo').value='';atualizarPreviewLogoEmpresa('')}
document.getElementById('empresa-logo-arquivo').addEventListener('change',e=>{const arquivo=e.target.files[0];if(!arquivo)return;if(!['image/png','image/jpeg'].includes(arquivo.type))return toast('Selecione uma imagem PNG ou JPG.','erro');if(arquivo.size>2*1024*1024){e.target.value='';return toast('O logo deve ter no máximo 2 MB.','erro')}const leitor=new FileReader();leitor.onload=()=>atualizarPreviewLogoEmpresa(leitor.result);leitor.onerror=()=>toast('Não foi possível ler o logo.','erro');leitor.readAsDataURL(arquivo)});
function abrirModalEmpresa(r){document.getElementById('modal-empresa').classList.replace('hidden','flex');document.getElementById('modal-empresa-titulo').textContent=r?'Editar empresa':'Nova empresa';document.getElementById('empresa-selecionada-resumo').textContent=r?`${r.RazaoSocial} · ${r.CNPJ}`:'Nova empresa';const vals={id:r?.ID||'',razao:r?.RazaoSocial||'',cnpj:r?.CNPJ||'',telefone:r?.Telefone||'',endereco:r?.Endereco||'',bairro:r?.Bairro||'',cidade:r?.CidadeUf||'',cep:r?.Cep||''};Object.entries(vals).forEach(([k,v])=>document.getElementById(`empresa-${k}`).value=v);document.getElementById('empresa-logo-arquivo').value='';atualizarPreviewLogoEmpresa(r?.LogoData||'')}
function fecharModalEmpresa(){document.getElementById('modal-empresa').classList.replace('flex','hidden')}
document.getElementById('form-empresa').addEventListener('submit',async e=>{e.preventDefault();const id=document.getElementById('empresa-id').value;const p={RazaoSocial:document.getElementById('empresa-razao').value.trim(),CNPJ:document.getElementById('empresa-cnpj').value.trim(),Telefone:document.getElementById('empresa-telefone').value.trim(),Endereco:document.getElementById('empresa-endereco').value.trim(),Bairro:document.getElementById('empresa-bairro').value.trim(),CidadeUf:document.getElementById('empresa-cidade').value.trim(),Cep:document.getElementById('empresa-cep').value.trim(),LogoData:document.getElementById('empresa-logo-data').value};try{await api(id?`empresas/${id}`:'empresas',{method:id?'PUT':'POST',body:JSON.stringify(p)});fecharModalEmpresa();carregarEmpresas();toast('Empresa salva.')}catch(err){toast(err.message,'erro')}})
async function excluirEmpresa(id){if(!await confirmarExclusao('Excluir esta empresa?'))return;try{await api(`empresas/${id}`,{method:'DELETE'});carregarEmpresas();toast('Empresa excluída.')}catch(err){toast(err.message,'erro')}}
function formatarDataBackup(valor){return valor?new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short'}).format(new Date(valor)):'Nunca realizado'}
async function carregarStatusBackup(){const s=await api('backup/status');document.getElementById('backup-intervalo').value=s.intervaloDias;document.getElementById('backup-retencao').value=s.retencaoDias;document.getElementById('backup-diretorio').textContent=s.diretorio;document.getElementById('backup-ultimo').textContent=formatarDataBackup(s.ultimoBackupEm);document.getElementById('backup-proximo').textContent=s.proximoBackupEm?formatarDataBackup(s.proximoBackupEm):'Será criado ao iniciar';const pasta=document.getElementById('backup-pasta-status');pasta.textContent=s.pastaAcessivel?'Pasta acessível e pronta para receber backups automáticos.':`Pasta indisponível: ${s.erroPasta||'verifique a configuração do volume.'}`;pasta.className=`text-body-md mt-3 ${s.pastaAcessivel?'text-green-700':'text-error'}`}
document.getElementById('form-backup-config').addEventListener('submit',async e=>{e.preventDefault();try{await api('backup/config',{method:'PUT',body:JSON.stringify({intervaloDias:Number(document.getElementById('backup-intervalo').value),retencaoDias:Number(document.getElementById('backup-retencao').value)})});await carregarStatusBackup();toast('Automação de backup salva.')}catch(err){toast(err.message,'erro')}})
function baixarSchemaBanco(){window.location.href=apiUrl('backup/schema')}
async function criarBackupCompleto(){const btn=document.getElementById('btn-criar-backup');btn.disabled=true;try{const res=await fetch(apiUrl('backup/criar'),{method:'POST',cache:'no-store'});if(!res.ok){let d={};try{d=await res.json()}catch(_){}throw new Error(d.erro||'Falha ao criar backup.')}const blob=await res.blob(),disp=res.headers.get('Content-Disposition')||'',match=disp.match(/filename="?([^";]+)"?/i),nome=match?match[1]:'gestao-ocupacional.medbackup',url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=nome;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);await carregarStatusBackup();toast('Backup completo criado e baixado.')}catch(err){toast(err.message,'erro')}finally{btn.disabled=false}}
async function validarArquivoBackup(){const input=document.getElementById('arquivo-backup'),arquivo=input.files[0];if(!arquivo)return toast('Selecione um arquivo .medbackup.','erro');const btn=document.getElementById('btn-validar-backup');btn.disabled=true;tokenBackupValidado='';document.getElementById('backup-validacao').classList.add('hidden');try{const res=await fetch(apiUrl('backup/validar'),{method:'POST',headers:{'Content-Type':'application/octet-stream'},body:await arquivo.arrayBuffer(),cache:'no-store'}),d=await res.json();if(!res.ok)throw new Error(d.erro||'Backup inválido.');tokenBackupValidado=d.token;document.getElementById('backup-validacao-resumo').innerHTML=`Criado em <strong>${escapeHtml(formatarDataBackup(d.criadoEm))}</strong> · ${d.tabelas} tabela(s) · ${d.registros} registro(s) · ${d.arquivos} arquivo(s).`;document.getElementById('backup-validacao').classList.remove('hidden');toast('Arquivo validado. Revise o resumo antes de restaurar.')}catch(err){toast(err.message,'erro')}finally{btn.disabled=false}}
async function restaurarBackupValidado(){if(!tokenBackupValidado)return toast('Valide o arquivo antes de restaurar.','erro');if(!await confirmarExclusao('A restauração substituirá TODOS os dados e configurações atuais. Deseja continuar?'))return;const btn=document.getElementById('btn-restaurar-backup');btn.disabled=true;try{const d=await api('backup/restaurar',{method:'POST',body:JSON.stringify({token:tokenBackupValidado,confirmacao:'RESTAURAR'})});toast(d.mensagem||'Backup restaurado.');setTimeout(()=>window.location.href=appUrl('configuracoes?aba=backup'),900)}catch(err){toast(err.message,'erro');btn.disabled=false}}
const abaInicial=new URLSearchParams(window.location.search).get('aba');if(['backup','aparencia','medico','empresas'].includes(abaInicial))mostrarAbaConfig(abaInicial);
Promise.all([carregarConfig(),carregarEmpresas(),carregarStatusBackup()]).catch(err=>toast(err.message,'erro'));
</script>
