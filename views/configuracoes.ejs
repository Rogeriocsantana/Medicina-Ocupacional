<% const pageTitle = 'Configurações'; %>
<%- include('partials/head', {pageTitle}) %>
<%- include('partials/nav', {pageTitle, active: 'configuracoes'}) %>

<div class="mb-stack-lg">
  <h3 class="font-headline-lg text-headline-lg text-on-surface">Configurações do ASO</h3>
  <p class="text-on-surface-variant text-body-md mt-1">Administre as empresas atendidas e o médico responsável.</p>
  <div class="inline-flex flex-wrap mt-5 bg-surface-container p-1 rounded-xl border border-border-subtle gap-1">
    <button onclick="mostrarAbaConfig('empresas')" data-aba="empresas" class="aba-config px-4 py-2 bg-surface text-primary font-bold rounded-lg shadow-sm text-body-md">Empresas</button>
    <button onclick="mostrarAbaConfig('medico')" data-aba="medico" class="aba-config px-4 py-2 text-on-surface-variant font-semibold rounded-lg text-body-md">Médico</button>
    <button onclick="mostrarAbaConfig('backup')" data-aba="backup" class="aba-config px-4 py-2 text-on-surface-variant font-semibold rounded-lg text-body-md">Backup</button>
  </div>
</div>

<section id="painel-empresas" class="painel-config max-w-5xl bg-surface border border-border-subtle rounded-xl p-6 space-y-4">
  <div class="flex justify-between items-center"><div><h4 class="font-headline-md">Empresas</h4><p class="text-body-md text-on-surface-variant">Cadastre as empresas que poderão ser vinculadas aos funcionários e exibidas no ASO.</p></div><button onclick="abrirModalEmpresa()" class="bg-primary text-white px-4 py-2 rounded-lg font-bold">Adicionar</button></div>
  <table class="w-full text-left"><thead class="border-b border-border-subtle"><tr><th class="py-2 text-label-caps uppercase">Razão social</th><th class="py-2 text-label-caps uppercase">CNPJ</th><th class="py-2 text-label-caps uppercase">Cidade/UF</th><th class="py-2 text-right text-label-caps uppercase">Ações</th></tr></thead><tbody id="tbody-empresas" class="font-table-data text-table-data"></tbody></table>
</section>

<form id="form-config" class="max-w-5xl">
  <section id="painel-medico" class="painel-config hidden bg-surface border border-border-subtle rounded-xl p-6 space-y-6">
    <div class="flex items-center gap-3 border-b border-border-subtle pb-4"><span id="preview-icone-medico" class="w-10 h-10 rounded-full bg-primary-fixed text-primary flex items-center justify-center"><span class="material-symbols-outlined">medical_services</span></span><div><h4 class="font-headline-md">Médico coordenador</h4><p class="text-body-md text-on-surface-variant">Esses dados aparecem no cabeçalho da aplicação e no ASO.</p></div></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="md:col-span-2"><label class="block text-body-md font-semibold mb-1">Médico</label><input id="Medico" required class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-1">CRM</label><input id="CRM" class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-1">Especialidade</label><input id="Especialidade" class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-1">RQE</label><input id="RQE" class="campo"></div>
      <div><label class="block text-body-md font-semibold mb-2">Ícone do médico</label><input id="IconeMedico" type="hidden" value="medical_services"><div id="opcoes-icone-medico" class="flex flex-wrap gap-2"><button type="button" data-icone="medical_services" onclick="selecionarIconeMedico('medical_services')" title="Serviços médicos" class="opcao-icone-medico"><span class="material-symbols-outlined">medical_services</span></button><button type="button" data-icone="stethoscope" onclick="selecionarIconeMedico('stethoscope')" title="Estetoscópio" class="opcao-icone-medico"><span class="material-symbols-outlined">stethoscope</span></button><button type="button" data-icone="health_and_safety" onclick="selecionarIconeMedico('health_and_safety')" title="Saúde e segurança" class="opcao-icone-medico"><span class="material-symbols-outlined">health_and_safety</span></button><button type="button" data-icone="clinical_notes" onclick="selecionarIconeMedico('clinical_notes')" title="Prontuário clínico" class="opcao-icone-medico"><span class="material-symbols-outlined">clinical_notes</span></button><button type="button" data-icone="cardiology" onclick="selecionarIconeMedico('cardiology')" title="Cardiologia" class="opcao-icone-medico"><span class="material-symbols-outlined">cardiology</span></button></div></div>
    </div>
    <div class="flex justify-end"><button type="submit" class="bg-primary text-white px-6 py-2.5 rounded-lg font-bold">Salvar configurações</button></div>
  </section>
</form>

<section id="painel-backup" class="painel-config hidden max-w-5xl space-y-5">
  <div class="bg-surface border border-border-subtle rounded-xl p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div><h4 class="font-headline-md">Backup automático</h4><p class="text-body-md text-on-surface-variant mt-1">Salva automaticamente todos os dados e arquivos institucionais na pasta configurada no servidor.</p></div>
      <div class="flex flex-wrap gap-3"><button type="button" onclick="baixarSchemaBanco()" class="border border-primary text-primary px-5 py-2.5 rounded-lg font-bold inline-flex items-center gap-2"><span class="material-symbols-outlined">database</span>Baixar schema SQL</button><button id="btn-criar-backup" type="button" onclick="criarBackupCompleto()" class="bg-primary text-white px-5 py-2.5 rounded-lg font-bold inline-flex items-center gap-2"><span class="material-symbols-outlined">download</span>Baixar backup agora</button></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-5">
      <div class="bg-background-main border border-border-subtle rounded-lg p-4"><p class="text-label-caps uppercase text-on-surface-variant">Pasta no servidor</p><p id="backup-diretorio" class="font-semibold mt-2 break-all">Carregando...</p></div>
      <div class="bg-background-main border border-border-subtle rounded-lg p-4"><p class="text-label-caps uppercase text-on-surface-variant">Último automático</p><p id="backup-ultimo" class="font-semibold mt-2">Carregando...</p></div>
      <div class="bg-background-main border border-border-subtle rounded-lg p-4"><p class="text-label-caps uppercase text-on-surface-variant">Próximo automático</p><p id="backup-proximo" class="font-semibold mt-2">–</p></div>
    </div>
    <form id="form-backup-config" class="flex flex-wrap items-end gap-3 mt-5">
      <div><label for="backup-intervalo" class="block text-body-md font-semibold mb-1">Criar a cada</label><div class="flex items-center gap-2"><input id="backup-intervalo" type="number" min="1" max="365" required class="campo w-28"><span class="text-body-md text-on-surface-variant">dias</span></div></div>
      <div><label for="backup-retencao" class="block text-body-md font-semibold mb-1">Manter por</label><div class="flex items-center gap-2"><input id="backup-retencao" type="number" min="1" max="3650" required class="campo w-28"><span class="text-body-md text-on-surface-variant">dias</span></div></div>
      <button class="px-4 py-2.5 border border-primary text-primary rounded-lg font-bold hover:bg-primary-fixed">Salvar automação</button>
    </form>
    <p id="backup-pasta-status" class="text-body-md text-on-surface-variant mt-3"></p>
  </div>

  <div class="bg-surface border border-border-subtle rounded-xl p-6">
    <div class="flex items-start gap-3"><span class="material-symbols-outlined text-error">restore</span><div><h4 class="font-headline-md">Restaurar backup</h4><p class="text-body-md text-on-surface-variant mt-1">A restauração substitui integralmente os dados atuais. O arquivo será validado antes de liberar a confirmação.</p></div></div>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <input id="arquivo-backup" type="file" accept=".medbackup,application/octet-stream" class="block flex-1 min-w-[18rem] text-body-md file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:bg-primary-fixed file:text-primary file:font-bold">
      <button id="btn-validar-backup" type="button" onclick="validarArquivoBackup()" class="px-5 py-2.5 border border-primary text-primary rounded-lg font-bold">Validar arquivo</button>
    </div>
    <div id="backup-validacao" class="hidden mt-5 border border-border-subtle rounded-lg p-4 bg-background-main">
      <p class="font-bold text-primary flex items-center gap-2"><span class="material-symbols-outlined">verified</span>Backup válido</p>
      <div id="backup-validacao-resumo" class="text-body-md text-on-surface-variant mt-2"></div>
      <div class="flex justify-end mt-4"><button id="btn-restaurar-backup" type="button" onclick="restaurarBackupValidado()" class="bg-error text-white px-5 py-2.5 rounded-lg font-bold inline-flex items-center gap-2"><span class="material-symbols-outlined">restore</span>Restaurar dados</button></div>
    </div>
  </div>
</section>

<div id="modal-empresa" class="fixed inset-0 z-50 hidden items-center justify-center modal-backdrop"><div class="bg-surface rounded-xl w-full max-w-2xl p-6 max-h-[90vh] overflow-y-auto"><h3 id="modal-empresa-titulo" class="font-headline-md mb-4">Empresa</h3><form id="form-empresa" class="grid grid-cols-1 md:grid-cols-2 gap-4"><input type="hidden" id="empresa-id"><div class="md:col-span-2"><label class="block font-semibold mb-1">Razão social</label><input id="empresa-razao" required class="campo"></div><div><label class="block font-semibold mb-1">CNPJ</label><input id="empresa-cnpj" required class="campo"></div><div><label class="block font-semibold mb-1">Telefone</label><input id="empresa-telefone" class="campo"></div><div class="md:col-span-2"><label class="block font-semibold mb-1">Endereço</label><input id="empresa-endereco" class="campo"></div><div><label class="block font-semibold mb-1">Bairro</label><input id="empresa-bairro" class="campo"></div><div><label class="block font-semibold mb-1">Cidade/UF</label><input id="empresa-cidade" class="campo"></div><div><label class="block font-semibold mb-1">CEP</label><input id="empresa-cep" class="campo"></div><div class="md:col-span-2 flex justify-end gap-3"><button type="button" onclick="fecharModalEmpresa()" class="px-4 py-2">Cancelar</button><button class="px-4 py-2 bg-primary text-white rounded-lg font-bold">Salvar</button></div></form></div></div>

<style>.campo{width:100%;padding:.625rem .75rem;border:1px solid #DEE2E6;border-radius:.5rem}.campo:focus{outline:2px solid #00478d;outline-offset:1px}.opcao-icone-medico{width:42px;height:42px;border:1px solid #DEE2E6;border-radius:.5rem;color:#424752}.opcao-icone-medico:hover,.opcao-icone-medico.ativo{background:#dce8f8;border-color:#00478d;color:#00478d}</style>
<script>
const CONFIG_FIELDS=['Medico','CRM','Especialidade','RQE','IconeMedico'];
let tokenBackupValidado='';
function mostrarAbaConfig(aba){document.querySelectorAll('.painel-config').forEach(p=>p.classList.toggle('hidden',p.id!==`painel-${aba}`));document.querySelectorAll('.aba-config').forEach(b=>b.className=`aba-config px-4 py-2 rounded-lg text-body-md ${b.dataset.aba===aba?'bg-surface text-primary font-bold shadow-sm':'text-on-surface-variant font-semibold'}`)}
function atualizarPreviewIcone(){const icone=document.getElementById('IconeMedico').value;document.querySelector('#preview-icone-medico .material-symbols-outlined').textContent=icone;document.querySelectorAll('.opcao-icone-medico').forEach(botao=>botao.classList.toggle('ativo',botao.dataset.icone===icone))}function selecionarIconeMedico(icone){document.getElementById('IconeMedico').value=icone;atualizarPreviewIcone()}
async function carregarConfig(){const cfg=await api('config');CONFIG_FIELDS.forEach(f=>{const el=document.getElementById(f);if(el)el.value=cfg[f]||''});atualizarPreviewIcone()}
document.getElementById('form-config').addEventListener('submit',async e=>{e.preventDefault();const payload={};CONFIG_FIELDS.forEach(f=>payload[f]=document.getElementById(f).value.trim());try{const config=await api('config',{method:'PUT',body:JSON.stringify(payload)});const medico=document.getElementById('nav-medico');const especialidade=document.getElementById('nav-especialidade');const icone=document.getElementById('nav-icone-medico');if(medico)medico.textContent=config.Medico||'Médico coordenador';if(especialidade)especialidade.textContent=config.Especialidade||'Medicina do Trabalho';if(icone)icone.textContent=config.IconeMedico||'medical_services';toast('Configurações salvas.')}catch(err){toast(err.message,'erro')}});
async function carregarEmpresas(){const rows=await api('empresas');document.getElementById('tbody-empresas').innerHTML=rows.map(r=>`<tr class="border-b border-border-subtle"><td class="py-3 font-semibold">${escapeHtml(r.RazaoSocial)}</td><td>${escapeHtml(r.CNPJ)}</td><td>${escapeHtml(r.CidadeUf||'')}</td><td class="text-right"><button onclick='abrirModalEmpresa(${JSON.stringify(r).replace(/'/g,"&#39;")})' class="p-2 text-primary hover:bg-primary-fixed rounded" title="Editar"><span class="material-symbols-outlined">edit</span></button><button onclick="excluirEmpresa(${r.ID})" class="p-2 text-error hover:bg-error-container rounded" title="Excluir"><span class="material-symbols-outlined">delete</span></button></td></tr>`).join('')||'<tr><td colspan="4" class="py-3 text-on-surface-variant">Nenhuma empresa cadastrada.</td></tr>'}
function abrirModalEmpresa(r){document.getElementById('modal-empresa').classList.replace('hidden','flex');document.getElementById('modal-empresa-titulo').textContent=r?'Editar empresa':'Nova empresa';const vals={id:r?.ID||'',razao:r?.RazaoSocial||'',cnpj:r?.CNPJ||'',telefone:r?.Telefone||'',endereco:r?.Endereco||'',bairro:r?.Bairro||'',cidade:r?.CidadeUf||'',cep:r?.Cep||''};Object.entries(vals).forEach(([k,v])=>document.getElementById(`empresa-${k}`).value=v)}
function fecharModalEmpresa(){document.getElementById('modal-empresa').classList.replace('flex','hidden')}
document.getElementById('form-empresa').addEventListener('submit',async e=>{e.preventDefault();const id=document.getElementById('empresa-id').value;const p={RazaoSocial:document.getElementById('empresa-razao').value.trim(),CNPJ:document.getElementById('empresa-cnpj').value.trim(),Telefone:document.getElementById('empresa-telefone').value.trim(),Endereco:document.getElementById('empresa-endereco').value.trim(),Bairro:document.getElementById('empresa-bairro').value.trim(),CidadeUf:document.getElementById('empresa-cidade').value.trim(),Cep:document.getElementById('empresa-cep').value.trim()};try{await api(id?`empresas/${id}`:'empresas',{method:id?'PUT':'POST',body:JSON.stringify(p)});fecharModalEmpresa();carregarEmpresas();toast('Empresa salva.')}catch(err){toast(err.message,'erro')}})
async function excluirEmpresa(id){if(!confirmarExclusao('Excluir esta empresa?'))return;try{await api(`empresas/${id}`,{method:'DELETE'});carregarEmpresas();toast('Empresa excluída.')}catch(err){toast(err.message,'erro')}}
function formatarDataBackup(valor){return valor?new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short'}).format(new Date(valor)):'Nunca realizado'}
async function carregarStatusBackup(){const s=await api('backup/status');document.getElementById('backup-intervalo').value=s.intervaloDias;document.getElementById('backup-retencao').value=s.retencaoDias;document.getElementById('backup-diretorio').textContent=s.diretorio;document.getElementById('backup-ultimo').textContent=formatarDataBackup(s.ultimoBackupEm);document.getElementById('backup-proximo').textContent=s.proximoBackupEm?formatarDataBackup(s.proximoBackupEm):'Será criado ao iniciar';const pasta=document.getElementById('backup-pasta-status');pasta.textContent=s.pastaAcessivel?'Pasta acessível e pronta para receber backups automáticos.':`Pasta indisponível: ${s.erroPasta||'verifique a configuração do volume.'}`;pasta.className=`text-body-md mt-3 ${s.pastaAcessivel?'text-green-700':'text-error'}`}
document.getElementById('form-backup-config').addEventListener('submit',async e=>{e.preventDefault();try{await api('backup/config',{method:'PUT',body:JSON.stringify({intervaloDias:Number(document.getElementById('backup-intervalo').value),retencaoDias:Number(document.getElementById('backup-retencao').value)})});await carregarStatusBackup();toast('Automação de backup salva.')}catch(err){toast(err.message,'erro')}})
function baixarSchemaBanco(){window.location.href=apiUrl('backup/schema')}
async function criarBackupCompleto(){const btn=document.getElementById('btn-criar-backup');btn.disabled=true;try{const res=await fetch(apiUrl('backup/criar'),{method:'POST',cache:'no-store'});if(!res.ok){let d={};try{d=await res.json()}catch(_){}throw new Error(d.erro||'Falha ao criar backup.')}const blob=await res.blob(),disp=res.headers.get('Content-Disposition')||'',match=disp.match(/filename="?([^";]+)"?/i),nome=match?match[1]:'gestao-ocupacional.medbackup',url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=nome;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);await carregarStatusBackup();toast('Backup completo criado e baixado.')}catch(err){toast(err.message,'erro')}finally{btn.disabled=false}}
async function validarArquivoBackup(){const input=document.getElementById('arquivo-backup'),arquivo=input.files[0];if(!arquivo)return toast('Selecione um arquivo .medbackup.','erro');const btn=document.getElementById('btn-validar-backup');btn.disabled=true;tokenBackupValidado='';document.getElementById('backup-validacao').classList.add('hidden');try{const res=await fetch(apiUrl('backup/validar'),{method:'POST',headers:{'Content-Type':'application/octet-stream'},body:await arquivo.arrayBuffer(),cache:'no-store'}),d=await res.json();if(!res.ok)throw new Error(d.erro||'Backup inválido.');tokenBackupValidado=d.token;document.getElementById('backup-validacao-resumo').innerHTML=`Criado em <strong>${escapeHtml(formatarDataBackup(d.criadoEm))}</strong> · ${d.tabelas} tabela(s) · ${d.registros} registro(s) · ${d.arquivos} arquivo(s).`;document.getElementById('backup-validacao').classList.remove('hidden');toast('Arquivo validado. Revise o resumo antes de restaurar.')}catch(err){toast(err.message,'erro')}finally{btn.disabled=false}}
async function restaurarBackupValidado(){if(!tokenBackupValidado)return toast('Valide o arquivo antes de restaurar.','erro');if(!window.confirm('A restauração substituirá TODOS os dados e configurações atuais. Deseja continuar?'))return;const btn=document.getElementById('btn-restaurar-backup');btn.disabled=true;try{const d=await api('backup/restaurar',{method:'POST',body:JSON.stringify({token:tokenBackupValidado,confirmacao:'RESTAURAR'})});toast(d.mensagem||'Backup restaurado.');setTimeout(()=>window.location.href=appUrl('configuracoes?aba=backup'),900)}catch(err){toast(err.message,'erro');btn.disabled=false}}
const abaInicial=new URLSearchParams(window.location.search).get('aba');if(abaInicial==='backup')mostrarAbaConfig('backup');
Promise.all([carregarConfig(),carregarEmpresas(),carregarStatusBackup()]).catch(err=>toast(err.message,'erro'));
</script>
<%- include('partials/foot') %>
